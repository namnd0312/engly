# Copy to engly-be/.env and fill real values. .env is gitignored; this template is committed.
# Source it before starting the backend:  set -a; . ./.env; set +a; ./mvnw spring-boot:run

# --- Google OAuth2 social login ---
# Google Cloud Console -> Credentials -> OAuth 2.0 Client ID (Web application).
# Authorized JavaScript origins: http://localhost:4200
# Authorized redirect URI:       http://localhost:4200/login/oauth2/code/google
# Leave blank to keep Google login disabled (app boots with password login only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook OAuth2 social login (optional) ---
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_API_VERSION=v19.0

# --- SMTP for account-activation emails ---
# Dev default: run Mailpit locally (docker run -p 1025:1025 -p 8025:8025 axllent/mailpit) and view
# sent mail at http://localhost:8025. Leave MAIL_USERNAME/MAIL_PASSWORD blank for Mailpit.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@engly.local

# --- Email activation on registration ---
# EMAIL_VERIFICATION_ENABLED=false is the rollback switch: register auto-verifies + issues a
# session immediately (pre-feature behavior) and login is not gated. No redeploy needed to flip it.
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_TTL=24h
EMAIL_VERIFICATION_RESEND_COOLDOWN=60s
