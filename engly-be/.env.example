# Copy to engly-be/.env and fill real values. .env is gitignored; this template is committed.
# Source it before starting the backend:  set -a; . ./.env; set +a; ./mvnw spring-boot:run

# --- Google OAuth2 social login ---
# Google Cloud Console -> Credentials -> OAuth 2.0 Client ID (Web application).
# Authorized JavaScript origins: http://localhost:4200
# Authorized redirect URI:       http://localhost:4200/login/oauth2/code/google
# Leave blank to keep Google login disabled (app boots with password login only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook OAuth2 social login (optional) ---
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_API_VERSION=v19.0
