<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>com.engly</groupId>
    <artifactId>engly</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>engly</name>
    <description>Engly — irregular-verb lookup backend</description>

    <properties>
        <java.version>21</java.version>
        <!-- Override Boot-managed TC (3.4.x → 1.20.x): 1.21.0 fixes OrbStack Docker API
             negotiation (TC 1.20.x hardcodes API 1.32; OrbStack requires >= 1.40). -->
        <testcontainers.version>1.21.0</testcontainers.version>
        <!-- JUnit5 tag filter for surefire; empty = run all. `unit-only` profile overrides. -->
        <test.excludedGroups></test.excludedGroups>
        <!-- Provisional JaCoCo gate floors; phase-06 re-pins from measured baseline. -->
        <jacoco.line.min>0.65</jacoco.line.min>
        <jacoco.branch.min>0.55</jacoco.branch.min>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- AWS SDK v2 (S3 + presigner for avatar uploads). BOM keeps artifact versions aligned. -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>2.25.70</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <!-- Stateless Bearer JWT validation for /api/admin/** (OAuth2 Resource Server). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- tus resumable upload server: disk-backed chunk store (buffers to disk, not RAM) →
             safe at 512MB heap for GB-scale CSV uploads. Jakarta/Servlet 6, Java 17+. -->
        <dependency>
            <groupId>me.desair.tus</groupId>
            <artifactId>tus-java-server</artifactId>
            <version>1.0.0-3.0</version>
        </dependency>
        <!-- Single-line, quote-aware CSV field parsing in the streaming processor. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.11.0</version>
        </dependency>
        <!-- S3 client + request presigner for avatar storage (endpoint-overridable: local
             emulator in dev, real AWS in prod). Version from the awssdk BOM above. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- OrbStack requires Docker API >= 1.40; TC defaults to 1.32.
                         Override the shaded docker-java config via JVM system property. -->
                    <systemPropertyVariables>
                        <api.version>1.44</api.version>
                    </systemPropertyVariables>
                    <!-- Disable Ryuk reaper to avoid a second Docker connection attempt. -->
                    <environmentVariables>
                        <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
                    </environmentVariables>
                    <!-- JUnit5 tag filter. Default empty (run all). The `unit-only` profile
                         sets this to `integration` so the Testcontainers-backed tests are
                         skipped when Docker/OrbStack is not running.
                         Do NOT hardcode <argLine> here — JaCoCo's prepare-agent injects via
                         ${argLine}; overriding it would silently disable coverage. -->
                    <excludedGroups>${test.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
            <!-- JaCoCo Code Coverage. Version pinned: spring-boot-starter-parent does NOT
                 manage jacoco-maven-plugin. prepare-agent (initialize) sets ${argLine};
                 report + check run at verify. Excludes kept byte-identical in both. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <destFile>${project.build.directory}/jacoco.exec</destFile>
                            <append>true</append>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco.exec</dataFile>
                            <outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
                            <excludes>
                                <exclude>com/engly/**/dto/**</exclude>
                                <exclude>**/*Response</exclude>
                                <exclude>**/*Request</exclude>
                                <exclude>**/SecurityConfig</exclude>
                                <exclude>**/AsyncConfig</exclude>
                                <exclude>**/TusUploadConfig</exclude>
                                <exclude>**/OidcRoleMappingConfig</exclude>
                                <exclude>**/EnglyApplication</exclude>
                                <exclude>**/S3ClientConfig*</exclude>
                                <exclude>**/AwsProperties*</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco.exec</dataFile>
                            <!-- Gate values are provisional. Phase-06 captures the real baseline
                                 (full `./mvnw verify` with Docker up) and sets the enforced floor
                                 to baseline minus a small margin. Override via -Djacoco.line.min /
                                 -Djacoco.branch.min without editing the pom. -->
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <excludes>
                                        <exclude>com/engly/**/dto/**</exclude>
                                        <exclude>**/*Response</exclude>
                                        <exclude>**/*Request</exclude>
                                        <exclude>**/SecurityConfig</exclude>
                                        <exclude>**/AsyncConfig</exclude>
                                        <exclude>**/TusUploadConfig</exclude>
                                        <exclude>**/OidcRoleMappingConfig</exclude>
                                        <exclude>**/EnglyApplication</exclude>
                                        <exclude>**/S3ClientConfig*</exclude>
                                        <exclude>**/AwsProperties*</exclude>
                                    </excludes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.min}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch.min}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Docker-free run: skips @Tag("integration") Testcontainers tests.
             Usage: ./mvnw test -Punit-only   (or: ./mvnw test -DexcludedGroups=integration) -->
        <profile>
            <id>unit-only</id>
            <properties>
                <test.excludedGroups>integration</test.excludedGroups>
            </properties>
        </profile>
    </profiles>

</project>
