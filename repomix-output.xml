    <header class="card-header">
      <div class="avatar-block">
        @if (user()?.avatarUrl) {
          <img class="avatar-img" [src]="user()!.avatarUrl" alt="Avatar" width="88" height="88" />
        } @else {
          <span class="avatar-img avatar-placeholder">{{ initial() }}</span>
        }
        <label class="avatar-edit" [class.disabled]="uploading()" title="Change avatar">
          <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true">
