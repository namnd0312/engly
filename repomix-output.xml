<file path="k8s/10-postgres-database.yaml">
# PostgreSQL for Engly: dev-grade single replica with a PVC.
# Credentials live in a Secret (dev values; replace for any non-local use).
apiVersion: v1
kind: Secret
metadata:
  name: engly-db-secret
  namespace: engly
type: Opaque
stringData:
  POSTGRES_DB: engly
  POSTGRES_USER: engly
  POSTGRES_PASSWORD: engly
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: engly-postgres-pvc
  namespace: engly
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: postgres
  namespace: engly
  labels:
    app: postgres
spec:
  replicas: 1
  selector:
    matchLabels:
      app: postgres
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: postgres
    spec:
      containers:
        - name: postgres
          image: postgres:16-alpine
          ports:
            - containerPort: 5432
          envFrom:
            - secretRef:
                name: engly-db-secret
          env:
            # Keep PGDATA in a subdir so the PVC mount root (lost+found) doesn't clash with initdb
            - name: PGDATA
              value: /var/lib/postgresql/data/pgdata
          volumeMounts:
            - name: pgdata
              mountPath: /var/lib/postgresql/data
          readinessProbe:
            exec:
              command: ["pg_isready", "-U", "engly", "-d", "engly"]
            initialDelaySeconds: 5
            periodSeconds: 5
          livenessProbe:
            exec:
              command: ["pg_isready", "-U", "engly", "-d", "engly"]
            initialDelaySeconds: 20
            periodSeconds: 10
      volumes:
        - name: pgdata
          persistentVolumeClaim:
            claimName: engly-postgres-pvc
---
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: engly
spec:
  selector:
    app: postgres
  ports:
    - port: 5432
      targetPort: 5432
</file>

<file path="k8s/deploy-to-orbstack.sh">
#!/usr/bin/env sh
# Build both Engly images into OrbStack's shared image store, then apply the k8s manifests.
# OrbStack's Docker engine and its Kubernetes cluster share an image store, so locally
# built images (non-:latest tag + imagePullPolicy IfNotPresent) need no registry push.
#
# Usage:  sh k8s/deploy-to-orbstack.sh
set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

echo "==> Ensuring kubectl context = orbstack"
kubectl config use-context orbstack

echo "==> Building backend image (engly-be:local)"
docker build -t engly-be:local ./engly-be

echo "==> Building frontend image (engly-fe:local)"
docker build -t engly-fe:local ./engly-fe

echo "==> Applying k8s manifests"
kubectl apply -f k8s/

echo "==> Waiting for rollouts"
kubectl -n engly rollout status deploy/postgres   --timeout=120s
kubectl -n engly rollout status deploy/engly-be    --timeout=180s
kubectl -n engly rollout status deploy/engly-fe    --timeout=120s

echo "==> Done. Services:"
kubectl -n engly get svc
</file>

<file path="k8s/start-app.sh">
#!/usr/bin/env bash
#
# start-app.sh - Start Engly app in Kubernetes by scaling deployments to 1 replica.
#
# Counterpart to ./stop-app.sh. Brings deployments that were scaled to 0 back up.
# The database is started first (when --all) so the backend can connect on boot.
#
# Usage:
#   ./start-app.sh           # start the app (engly-be + engly-fe)
#   ./start-app.sh --all     # also start the postgres database first
#   ./start-app.sh -n myns   # override namespace (default: engly)
#
set -euo pipefail

NAMESPACE="engly"
APP_DEPLOYMENTS=("engly-be" "engly-fe")
DB_DEPLOYMENTS=("postgres")
INCLUDE_DB=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --all|-a)       INCLUDE_DB=true; shift ;;
    -n|--namespace) NAMESPACE="$2"; shift 2 ;;
    -h|--help)
      grep '^#' "$0" | sed 's/^#//'
      exit 0 ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1 ;;
  esac
done

command -v kubectl >/dev/null 2>&1 || { echo "Error: kubectl not found in PATH" >&2; exit 1; }

# DB first so the backend has something to connect to on startup.
targets=()
$INCLUDE_DB && targets+=("${DB_DEPLOYMENTS[@]}")
targets+=("${APP_DEPLOYMENTS[@]}")

echo "Starting deployments in namespace '$NAMESPACE': ${targets[*]}"

for dep in "${targets[@]}"; do
  if kubectl -n "$NAMESPACE" get deployment "$dep" >/dev/null 2>&1; then
    echo "  -> scaling $dep to 1"
    kubectl -n "$NAMESPACE" scale deployment "$dep" --replicas=1
  else
    echo "  -> skip $dep (not found)"
  fi
done

echo "Waiting for pods to become ready..."
for dep in "${targets[@]}"; do
  kubectl -n "$NAMESPACE" rollout status deployment "$dep" --timeout=180s 2>/dev/null || true
done

echo "Done. Current state:"
kubectl -n "$NAMESPACE" get deployments
</file>

<file path="k8s/stop-app.sh">
#!/usr/bin/env bash
#
# stop-app.sh - Stop Engly app in Kubernetes by scaling deployments to 0 replicas.
#
# Scaling to 0 (instead of `kubectl delete`) keeps the Deployments, Services,
# PVC and Secret intact, so `./start-app.sh` (or scaling back up) restores the
# app without losing data or config.
#
# Usage:
#   ./stop-app.sh           # stop the app (engly-be + engly-fe)
#   ./stop-app.sh --all     # also stop the postgres database
#   ./stop-app.sh -n myns   # override namespace (default: engly)
#
set -euo pipefail

NAMESPACE="engly"
APP_DEPLOYMENTS=("engly-be" "engly-fe")
DB_DEPLOYMENTS=("postgres")
INCLUDE_DB=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --all|-a)       INCLUDE_DB=true; shift ;;
    -n|--namespace) NAMESPACE="$2"; shift 2 ;;
    -h|--help)
      grep '^#' "$0" | sed 's/^#//'
      exit 0 ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1 ;;
  esac
done

command -v kubectl >/dev/null 2>&1 || { echo "Error: kubectl not found in PATH" >&2; exit 1; }

targets=("${APP_DEPLOYMENTS[@]}")
$INCLUDE_DB && targets+=("${DB_DEPLOYMENTS[@]}")

echo "Stopping deployments in namespace '$NAMESPACE': ${targets[*]}"

for dep in "${targets[@]}"; do
  if kubectl -n "$NAMESPACE" get deployment "$dep" >/dev/null 2>&1; then
    echo "  -> scaling $dep to 0"
    kubectl -n "$NAMESPACE" scale deployment "$dep" --replicas=0
  else
    echo "  -> skip $dep (not found)"
  fi
done

echo "Waiting for pods to terminate..."
for dep in "${targets[@]}"; do
  kubectl -n "$NAMESPACE" rollout status deployment "$dep" --timeout=120s 2>/dev/null || true
done

echo "Done. Current state:"
kubectl -n "$NAMESPACE" get deployments
</file>

