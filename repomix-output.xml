.state-msg {
  padding: 1rem;
  border-radius: 6px;
  font-size: 0.95rem;
  text-align: center;
}

.loading-msg { color: #475569; }
.error-msg   { background: #fef2f2; color: #b91c1c; border: 1px solid #fca5a5; }

/* Session expired */
.expired-box {
  background: #fef9c3;
  border: 1px solid #fde68a;
  border-radius: 12px;
  padding: 2rem;
  text-align: center;
}

.expired-msg {
  color: #92400e;
  font-size: 1rem;
  margin: 0 0 1rem;
}

.relogin-btn {
  background: #6366f1;
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 0.55rem 1.4rem;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
}

.relogin-btn:hover {
  background: #4f46e5;
}

/* Done / empty state */
.done-box {
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  border-radius: 12px;
  padding: 2.5rem 2rem;
  text-align: center;
}

.done-title {
  font-size: 1.3rem;
  font-weight: 700;
  color: #15803d;
  margin: 0 0 0.5rem;
}

.done-sub {
  color: #64748b;
  margin: 0 0 1.5rem;
}

.back-btn {
  background: #6366f1;
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 0.55rem 1.4rem;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
}

.back-btn:hover {
  background: #4f46e5;
}

.done-actions {
  display: flex;
  gap: 0.75rem;
  justify-content: center;
  flex-wrap: wrap;
}

.back-btn-secondary {
  background: transparent;
  color: #6366f1;
  border: 1px solid #c7d2fe;
}

.back-btn-secondary:hover {
  background: #eef2ff;
}

/* Progress bar */
.session-wrapper {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.progress-bar-wrap {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.progress-bar-track {
  flex: 1;
  height: 8px;
  background: #e2e8f0;
  border-radius: 999px;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: #6366f1;
  border-radius: 999px;
  transition: width 0.3s ease;
}

.progress-label {
  font-size: 0.85rem;
  color: #64748b;
  white-space: nowrap;
}

/* Flashcard */
.card {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  padding: 2rem 1.75rem;
  min-height: 220px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-shadow: 0 2px 8px rgba(99, 102, 241, 0.08);
  gap: 1rem;
}

.card-face {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
  width: 100%;
}

.part-of-speech {
  font-size: 0.78rem;
  font-weight: 600;
  color: #6366f1;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  background: #ede9fe;
  padding: 0.2rem 0.6rem;
  border-radius: 999px;
}

.term-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

.card-term {
  font-size: 2rem;
  font-weight: 700;
  color: #1a1a2e;
  margin: 0;
}

.speak-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.35rem;
  background: transparent;
  border: none;
  border-radius: 999px;
  color: #6366f1;
  cursor: pointer;
  line-height: 0;
  transition: background 0.15s ease, color 0.15s ease;
}

.speak-btn:hover {
  background: #ede9fe;
  color: #4f46e5;
}

.speak-btn:focus-visible {
  outline: 2px solid #6366f1;
  outline-offset: 2px;
}

.flip-btn {
  background: #6366f1;
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 0.5rem 1.4rem;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  margin-top: 0.5rem;
}

.flip-btn:hover {
  background: #4f46e5;
}

/* Back face content */
.card-back-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
}

.card-meaning {
  font-size: 1.4rem;
  font-weight: 600;
  color: #0f766e;
  margin: 0;
}

.card-ipa {
  font-family: 'Courier New', monospace;
  font-size: 0.9rem;
  color: #475569;
  margin: 0;
}

.card-example-en {
  font-size: 0.9rem;
  color: #334155;
  font-style: italic;
  margin: 0;
}

.card-example-vi {
  font-size: 0.85rem;
  color: #64748b;
  margin: 0;
}

/* Rating buttons */
.rating-row {
  display: flex;
  gap: 0.75rem;
  justify-content: center;
  flex-wrap: wrap;
}

.rating-btn {
  flex: 1;
  min-width: 80px;
  padding: 0.6rem 0.5rem;
  border: none;
  border-radius: 8px;
  font-size: 0.9rem;
  font-weight: 700;
  cursor: pointer;
  transition: opacity 0.15s, transform 0.1s;
}

.rating-btn:active:not(:disabled) {
  transform: scale(0.97);
}

.rating-btn:disabled {
  opacity: 0.5;
  cursor: default;
}

.rating-again { background: #fef2f2; color: #b91c1c; border: 1px solid #fca5a5; }
.rating-again:hover:not(:disabled) { background: #fee2e2; }

.rating-hard  { background: #fff7ed; color: #c2410c; border: 1px solid #fdba74; }
.rating-hard:hover:not(:disabled)  { background: #ffedd5; }

.rating-good  { background: #ede9fe; color: #4f46e5; border: 1px solid #c4b5fd; }
.rating-good:hover:not(:disabled)  { background: #ddd6fe; }

.rating-easy  { background: #f0fdf4; color: #15803d; border: 1px solid #86efac; }
.rating-easy:hover:not(:disabled)  { background: #dcfce7; }
</file>

<file path="engly-fe/src/app/features/study/flashcard-session-page.component.html">
<section class="session-page">

  @if (loading()) {
    <p class="state-msg loading-msg">Đang tải thẻ...</p>
  }

  @if (loadError()) {
    <p class="state-msg error-msg" role="alert">{{ loadError() }}</p>
  }

  @if (sessionExpired()) {
    <div class="expired-box" role="alert">
      <p class="expired-msg">Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại để tiếp tục.</p>
      <button type="button" class="relogin-btn" (click)="reLogin()">Đăng nhập lại</button>
    </div>
  }

  @if (empty()) {
    <div class="done-box">
      <p class="done-title">Không còn thẻ cho hôm nay!</p>
      <p class="done-sub">
        Bạn đã học hết thẻ đến hạn và thẻ mới trong ngày cho bộ này.
        Hãy quay lại vào ngày mai, hoặc tăng số thẻ mới mỗi ngày trong phần Cài đặt để học thêm.
      </p>
      <div class="done-actions">
        <button type="button" class="back-btn" (click)="goToSettings()">Chỉnh cài đặt</button>
        <button type="button" class="back-btn back-btn-secondary" (click)="backToDecks()">Quay lại danh sách</button>
      </div>
    </div>
  }

  @if (done()) {
    <div class="done-box">
      <p class="done-title">Xuất sắc! Bạn đã học xong hôm nay.</p>
      <p class="done-sub">{{ total() }} thẻ đã được ôn tập.</p>
      <button type="button" class="back-btn" (click)="backToDecks()">Quay lại danh sách</button>
    </div>
  }

  @if (!loading() && !loadError() && !sessionExpired() && !done() && !empty() && currentCard()) {
    <div class="session-wrapper">
      <!-- Progress bar -->
      <div class="progress-bar-wrap">
        <div class="progress-bar-track">
          <div
            class="progress-bar-fill"
            [style.width.%]="(index() / total()) * 100"
          ></div>
        </div>
        <span class="progress-label">{{ index() + 1 }} / {{ total() }}</span>
      </div>

      <!-- Flashcard -->
      <div class="card" [class.flipped]="flipped()">
        <!-- Front: term -->
        <div class="card-face card-front">
          @if (currentCard()!.partOfSpeech) {
            <span class="part-of-speech">{{ currentCard()!.partOfSpeech }}</span>
          }
          <div class="term-row">
            <p class="card-term">{{ currentCard()!.term }}</p>
            @if (pronunciation.isSupported) {
              <button
                type="button"
                class="speak-btn"
                aria-label="Phát âm"
                (click)="pronounce($event)"
              >
                <svg viewBox="0 0 20 20" width="22" height="22" aria-hidden="true">
                  <path d="M4 8H2.5A1.5 1.5 0 001 9.5v1A1.5 1.5 0 002.5 12H4l4 3.5A.75.75 0 009 15V5a.75.75 0 00-1-.75L4 8z"
                    fill="currentColor" />
                  <path d="M12.5 7.5a3.5 3.5 0 010 5M14.5 5a6.5 6.5 0 010 10"
                    fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              </button>
            }
          </div>
          @if (!flipped()) {
            <button type="button" class="flip-btn" (click)="flip()">Xem nghĩa</button>
          }
        </div>

        <!-- Back: meaning + details (shown after flip) -->
        @if (flipped()) {
          <div class="card-back-content">
            <p class="card-meaning">{{ currentCard()!.meaningVi }}</p>
            @if (currentCard()!.ipa) {
              <p class="card-ipa">/{{ currentCard()!.ipa }}/</p>
            }
            @if (currentCard()!.exampleEn) {
              <p class="card-example-en">{{ currentCard()!.exampleEn }}</p>
            }
            @if (currentCard()!.exampleVi) {
              <p class="card-example-vi">{{ currentCard()!.exampleVi }}</p>
            }
          </div>
        }
      </div>

      <!-- Rating buttons (only after flip) -->
      @if (flipped()) {
        <div class="rating-row">
          @for (r of ratings; track r) {
            <button
              type="button"
              class="rating-btn"
              [class]="'rating-btn rating-' + r.toLowerCase()"
              [disabled]="submitting()"
              (click)="rate(r)"
            >
              {{ r === 'AGAIN' ? 'Lại' : r === 'HARD' ? 'Khó' : r === 'GOOD' ? 'Tốt' : 'Dễ' }}
            </button>
          }
        </div>
      }

      @if (ratingError()) {
        <p class="state-msg error-msg" role="alert">{{ ratingError() }}</p>
      }

      @if (submitting()) {
        <p class="state-msg loading-msg">Đang lưu...</p>
      }
    </div>
  }

</section>
</file>

<file path="engly-fe/src/app/features/study/flashcard-session-page.component.spec.ts">
import { ComponentFixture, TestBed } from '@angular/core/testing';
import { provideHttpClient } from '@angular/common/http';
import {
  HttpTestingController,
  provideHttpClientTesting,
} from '@angular/common/http/testing';
import { provideRouter } from '@angular/router';
import { ActivatedRoute } from '@angular/router';
import { FlashcardSessionPageComponent } from './flashcard-session-page.component';
import { StudyCard } from './data/study.model';
import { PronunciationService } from '../../core/pronunciation.service';

/** Factory for a minimal study card. */
function makeCard(overrides: Partial<StudyCard> = {}): StudyCard {
  return {
    cardStateId: 1,
    wordId: 101,
    term: 'hello',
    meaningVi: 'xin chào',
    ipa: null,
    exampleEn: null,
    exampleVi: null,
    partOfSpeech: null,
    state: 'NEW',
    ...overrides,
  };
}

const MOCK_REVIEW_RESULT = {
  wordId: 101,
  state: 'REVIEW',
  intervalDays: 1,
  dueOn: '2026-06-16',
  repetitions: 1,
  easeFactor: 2.5,
  lapses: 0,
};

describe('FlashcardSessionPageComponent', () => {
  let fixture: ComponentFixture<FlashcardSessionPageComponent>;
  let component: FlashcardSessionPageComponent;
  let httpTesting: HttpTestingController;

  beforeEach(async () => {
    await TestBed.configureTestingModule({
      imports: [FlashcardSessionPageComponent],
      providers: [
        provideHttpClient(),
        provideHttpClientTesting(),
        provideRouter([]),
        {
          provide: ActivatedRoute,
          useValue: { snapshot: { paramMap: { get: () => '42' } } },
        },
      ],
    }).compileComponents();

    fixture = TestBed.createComponent(FlashcardSessionPageComponent);
    component = fixture.componentInstance;
    httpTesting = TestBed.inject(HttpTestingController);
  });

  afterEach(() => httpTesting.verify());

  function initWithCards(cards: StudyCard[]): void {
    fixture.detectChanges(); // triggers ngOnInit → GET queue
    httpTesting.expectOne('/api/study/decks/42/queue').flush(cards);
    fixture.detectChanges();
  }

  // -------------------------------------------------------------------------
  // Init
  // -------------------------------------------------------------------------

  it('should create and show loading before queue arrives', () => {
    fixture.detectChanges();
    expect(component).toBeTruthy();
    expect(component.loading()).toBeTrue();
    httpTesting.expectOne('/api/study/decks/42/queue').flush([]);
  });

  it('GETs queue for the deck id from route params', () => {
    fixture.detectChanges();
    const req = httpTesting.expectOne('/api/study/decks/42/queue');
    expect(req.request.method).toBe('GET');
    req.flush([]);
  });

  it('populates queue signal and clears loading after queue loads', () => {
    initWithCards([makeCard()]);
    expect(component.queue().length).toBe(1);
    expect(component.loading()).toBeFalse();
  });

  // -------------------------------------------------------------------------
  // Flip behaviour
  // -------------------------------------------------------------------------

  it('flipped signal starts false', () => {
    initWithCards([makeCard()]);
    expect(component.flipped()).toBeFalse();
  });

  it('flip() sets flipped to true', () => {
    initWithCards([makeCard()]);
    component.flip();
    expect(component.flipped()).toBeTrue();
  });

  it('flip button is rendered in the DOM before flipping', () => {
    initWithCards([makeCard()]);
    const btn: HTMLElement | null = fixture.nativeElement.querySelector('.flip-btn');
    expect(btn).toBeTruthy();
  });

  // -------------------------------------------------------------------------
  // Pronunciation (speaker icon)
  // -------------------------------------------------------------------------

  it('renders the speaker button on the front face when TTS is supported', () => {
    initWithCards([makeCard()]);
    const btn: HTMLElement | null = fixture.nativeElement.querySelector('.speak-btn');
    expect(btn).toBeTruthy();
  });

  it('pronounce() speaks the current term without flipping the card', () => {
    initWithCards([makeCard({ term: 'run' })]);
    const speakSpy = spyOn(TestBed.inject(PronunciationService), 'speak');

    component.pronounce(new MouseEvent('click'));

    expect(speakSpy).toHaveBeenCalledWith('run');
    expect(component.flipped()).toBeFalse();
  });

  it('clicking the speaker button speaks and does not flip the card', () => {
    initWithCards([makeCard({ term: 'jump' })]);
    const speakSpy = spyOn(TestBed.inject(PronunciationService), 'speak');

    fixture.nativeElement.querySelector('.speak-btn').click();

    expect(speakSpy).toHaveBeenCalledWith('jump');
    expect(component.flipped()).toBeFalse();
  });

  // -------------------------------------------------------------------------
  // Rating — posts correct rating and advances index
  // -------------------------------------------------------------------------

  it('rate(GOOD) POSTs correct body and advances index', () => {
    initWithCards([makeCard({ wordId: 101 }), makeCard({ wordId: 102, term: 'bye' })]);

    // Flip first
    component.flip();
    fixture.detectChanges();

    component.rate('GOOD');

    const req = httpTesting.expectOne('/api/study/review');
    expect(req.request.method).toBe('POST');
    expect(req.request.body).toEqual({ wordId: 101, rating: 'GOOD' });
    req.flush(MOCK_REVIEW_RESULT);
    fixture.detectChanges();

    // Index advances to 1; flipped resets
    expect(component.index()).toBe(1);
    expect(component.flipped()).toBeFalse();
  });

  it('rate(AGAIN) sends AGAIN rating', () => {
    initWithCards([makeCard({ wordId: 55 })]);
    component.flip();
    component.rate('AGAIN');
    const req = httpTesting.expectOne('/api/study/review');
    expect(req.request.body.rating).toBe('AGAIN');
    req.flush(MOCK_REVIEW_RESULT);
  });

  it('rate(EASY) sends EASY rating', () => {
    initWithCards([makeCard({ wordId: 66 })]);
    component.flip();
    component.rate('EASY');
    const req = httpTesting.expectOne('/api/study/review');
    expect(req.request.body.rating).toBe('EASY');
    req.flush(MOCK_REVIEW_RESULT);
  });

  // -------------------------------------------------------------------------
  // Done state
  // -------------------------------------------------------------------------

  it('done() is true after all cards are rated', () => {
    initWithCards([makeCard({ wordId: 10 })]);
    component.flip();
    component.rate('GOOD');
    httpTesting.expectOne('/api/study/review').flush(MOCK_REVIEW_RESULT);
    fixture.detectChanges();

    expect(component.done()).toBeTrue();
  });

  it('empty() is true when queue is empty', () => {
    initWithCards([]);
    expect(component.empty()).toBeTrue();
  });

  // -------------------------------------------------------------------------
  // 401 sets sessionExpired
  // -------------------------------------------------------------------------

  it('sets sessionExpired when queue load returns 401', () => {
    fixture.detectChanges();
    httpTesting
      .expectOne('/api/study/decks/42/queue')
      .flush({ message: 'Unauthorized' }, { status: 401, statusText: 'Unauthorized' });
    fixture.detectChanges();

    expect(component.sessionExpired()).toBeTrue();
    expect(component.loading()).toBeFalse();
  });

  it('sets sessionExpired when review POST returns 401', () => {
    initWithCards([makeCard({ wordId: 77 })]);
    component.flip();
    component.rate('GOOD');

    httpTesting
      .expectOne('/api/study/review')
      .flush({ message: 'Unauthorized' }, { status: 401, statusText: 'Unauthorized' });
    fixture.detectChanges();

    expect(component.sessionExpired()).toBeTrue();
  });

  it('sets ratingError on non-401 review failure', () => {
    initWithCards([makeCard({ wordId: 88 })]);
    component.flip();
    component.rate('HARD');

    httpTesting
      .expectOne('/api/study/review')
      .flush({ message: 'Server error' }, { status: 500, statusText: 'Internal Server Error' });
    fixture.detectChanges();

    expect(component.ratingError()).toBeTruthy();
    expect(component.sessionExpired()).toBeFalse();
  });
});

describe('FlashcardSessionPageComponent — no TTS support', () => {
  it('hides the speaker button when speech synthesis is unsupported', async () => {
    await TestBed.configureTestingModule({
      imports: [FlashcardSessionPageComponent],
      providers: [
        provideHttpClient(),
        provideHttpClientTesting(),
        provideRouter([]),
        { provide: ActivatedRoute, useValue: { snapshot: { paramMap: { get: () => '42' } } } },
        { provide: PronunciationService, useValue: { isSupported: false, speak: () => {} } },
      ],
    }).compileComponents();

    const fixture = TestBed.createComponent(FlashcardSessionPageComponent);
    const httpTesting = TestBed.inject(HttpTestingController);
    fixture.detectChanges();
    httpTesting.expectOne('/api/study/decks/42/queue').flush([makeCard()]);
    fixture.detectChanges();

    expect(fixture.nativeElement.querySelector('.speak-btn')).toBeNull();
    httpTesting.verify();
  });
});
</file>

<file path="engly-fe/src/app/features/study/flashcard-session-page.component.ts">
import { Component, OnInit, OnDestroy, signal, computed, inject } from '@angular/core';
import { ActivatedRoute, Router } from '@angular/router';
import { Subscription } from 'rxjs';
import { StudyApiService } from './data/study-api.service';
import { StudyCard, ReviewRating } from './data/study.model';
import { PronunciationService } from '../../core/pronunciation.service';

/**
 * Flashcard session page (/study/:deckId).
 * Fetches the study queue for a deck, shows one card at a time (term → meaning),
 * supports flip to reveal answer, 4 self-rating buttons, progress bar, and done state.
 * Mid-session 401: surfaces inline message + re-login button (no silent redirect).
 */
@Component({
  selector: 'app-flashcard-session-page',
  standalone: true,
  templateUrl: './flashcard-session-page.component.html',
  styleUrl: './flashcard-session-page.component.css',
})
export class FlashcardSessionPageComponent implements OnInit, OnDestroy {
  private readonly studyApi = inject(StudyApiService);
  private readonly route = inject(ActivatedRoute);
  private readonly router = inject(Router);
  protected readonly pronunciation = inject(PronunciationService);

  readonly queue = signal<StudyCard[]>([]);
  readonly index = signal(0);
  readonly flipped = signal(false);
  readonly loading = signal(true);
  readonly loadError = signal<string | null>(null);
  readonly ratingError = signal<string | null>(null);
  readonly sessionExpired = signal(false);
  readonly submitting = signal(false);

  readonly currentCard = computed(() => this.queue()[this.index()] ?? null);
  readonly done = computed(() => !this.loading() && this.queue().length > 0 && this.index() >= this.queue().length);
  readonly empty = computed(() => !this.loading() && this.queue().length === 0 && !this.loadError());
  readonly total = computed(() => this.queue().length);

  readonly ratings: ReviewRating[] = ['AGAIN', 'HARD', 'GOOD', 'EASY'];

  private deckId!: number;
  private sub?: Subscription;

  ngOnInit(): void {
    this.deckId = Number(this.route.snapshot.paramMap.get('deckId'));
    this.sub = this.studyApi.getQueue(this.deckId).subscribe({
      next: (cards) => {
        this.queue.set(cards);
        this.loading.set(false);
      },
      error: (err) => {
        if (err?.status === 401) {
          this.sessionExpired.set(true);
        } else {
          this.loadError.set(err?.error?.message ?? 'Failed to load study queue.');
        }
        this.loading.set(false);
      },
    });
  }

  ngOnDestroy(): void {
    this.sub?.unsubscribe();
  }

  flip(): void {
    this.flipped.set(true);
  }

  /** Pronounce the current card's English term. stopPropagation keeps the click off the card (no flip). */
  pronounce(event: Event): void {
    event.stopPropagation();
    const term = this.currentCard()?.term;
    if (term) this.pronunciation.speak(term);
  }

  rate(rating: ReviewRating): void {
    const card = this.currentCard();
    if (!card || this.submitting()) return;

    this.submitting.set(true);
    this.ratingError.set(null);

    this.studyApi.review(card.wordId, rating).subscribe({
      next: () => {
        this.submitting.set(false);
        this.index.set(this.index() + 1);
        this.flipped.set(false);
      },
      error: (err) => {
        this.submitting.set(false);
        if (err?.status === 401) {
          this.sessionExpired.set(true);
        } else {
          this.ratingError.set(err?.error?.message ?? 'Failed to submit rating. Please try again.');
        }
      },
    });
  }

  reLogin(): void {
    this.router.navigate(['/login']);
  }

  backToDecks(): void {
    this.router.navigate(['/study']);
  }

  goToSettings(): void {
    this.router.navigate(['/study/settings']);
  }
}
</file>

