import { Component, inject, signal } from '@angular/core';
import { Router, RouterLink, ActivatedRoute } from '@angular/router';
import { FormsModule } from '@angular/forms';
import { AuthService } from '../../core/auth.service';
import { SocialLoginButtonsComponent } from './social-login-buttons.component';

/**
 * Email/password login page.
 * Route: /login (public — no guard).
 * On success navigates to returnUrl query param or '/'.
 */
@Component({
  selector: 'app-login-page',
  standalone: true,
  imports: [FormsModule, RouterLink, SocialLoginButtonsComponent],
  template: `
    <section class="auth-page">
      <h1 class="page-title">Đăng nhập</h1>

      <form class="auth-form" (ngSubmit)="submit()" #f="ngForm" novalidate>
        <label class="field-label" for="email">Email</label>
        <input
          id="email"
          class="field-input"
          type="email"
          name="email"
          [(ngModel)]="email"
          required
          autocomplete="email"
          placeholder="ban@example.com"
        />

        <label class="field-label" for="password">Mật khẩu</label>
        <input
          id="password"
          class="field-input"
          type="password"
          name="password"
          [(ngModel)]="password"
          required
          autocomplete="current-password"
          placeholder="••••••••"
        />

        @if (errorMessage()) {
          <p class="error-msg" role="alert">{{ errorMessage() }}</p>
        }

        @if (showResend()) {
          <button type="button" class="btn btn-secondary" (click)="resend()" [disabled]="resending()">
            {{ resending() ? 'Đang gửi…' : 'Gửi lại email kích hoạt' }}
          </button>
          @if (resendMessage()) {
            <p class="hint-msg">{{ resendMessage() }}</p>
          }
        }

        <button type="submit" class="btn btn-primary" [disabled]="loading()">
          {{ loading() ? 'Đang đăng nhập…' : 'Đăng nhập' }}
        </button>
      </form>

      <app-social-login-buttons />

      <p class="switch-link">
        Chưa có tài khoản? <a routerLink="/register">Đăng ký</a>
      </p>
    </section>
  `,
  styles: [
    `
      .auth-page {
        max-width: 400px;
        margin: 4rem auto;
        padding: 2rem 1.5rem;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        font-family: system-ui, sans-serif;
      }

      .page-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a1a2e;
        margin: 0 0 1.5rem;
