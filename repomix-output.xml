    @Test
    void search_deckIdOnlyBlankQ_callsFindByDeckId() {
        // blank q → hasQ=false → routes to findByDeck_Id branch
        when(wordRepository.findByDeck_Id(eq(1L), any(Pageable.class))).thenReturn(Page.empty());

        service.search("   ", 1L, 0, 20);

