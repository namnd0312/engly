.progress-page {
  max-width: 1100px;
  margin: 0 auto;
  padding: 1.5rem 1.25rem 3rem;
  font-family: system-ui, -apple-system, sans-serif;
  color: #1e293b;
}

.page-title {
  font-size: 1.5rem;
  font-weight: 700;
  color: #1a1a2e;
  margin: 0 0 1.25rem;
}

.state-msg {
  padding: 2rem 0;
  text-align: center;
  color: #64748b;
  font-size: 0.95rem;
}
.state-error {
  color: #dc2626;
}

/* KPI cards */
.kpi-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 0.9rem;
  margin-bottom: 1.5rem;
}
.kpi-card {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  padding: 1rem 1.1rem;
  background: linear-gradient(180deg, #1e1e3f 0%, #17172e 100%);
  border-radius: 14px;
  box-shadow: 0 2px 12px rgba(99, 102, 241, 0.18);
}
.kpi-value {
  font-size: 1.7rem;
  font-weight: 800;
  color: #f1f5f9;
  line-height: 1.1;
}
.kpi-label {
  font-size: 0.78rem;
  font-weight: 500;
  color: #8b90b8;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

/* Chart grid */
.chart-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1.1rem;
}
.chart-panel {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  padding: 1.1rem 1.2rem 1.3rem;
  box-shadow: 0 1px 8px rgba(17, 24, 39, 0.05);
}
.chart-panel-wide {
  grid-column: span 2;
}
@media (max-width: 720px) {
  .chart-panel-wide {
    grid-column: span 1;
  }
}

.chart-title {
  font-size: 0.95rem;
  font-weight: 600;
  color: #334155;
  margin: 0 0 0.9rem;
}

/* Fixed-height box so chart.js (maintainAspectRatio:false) has a stable canvas to fill. */
.chart-box {
  position: relative;
  height: 240px;
}
.chart-empty {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  color: #94a3b8;
  font-size: 0.85rem;
  pointer-events: none;
}
