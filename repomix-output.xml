<file path="engly-be/src/main/resources/db/migration/V5__create_vocab_import_tables.sql">
-- V5: CSV bulk-import job tracking + per-deck term uniqueness
-- vocab_import_job    — one row per upload→import run; holds progress + lease + crash-resume offset
-- vocab_import_error  — bad-row report rows (skipped lines) for a job
-- Plus: dedupe vocab_word (defensive) then UNIQUE (deck_id, term) → drives ON CONFLICT DO NOTHING idempotency.

CREATE TABLE IF NOT EXISTS vocab_import_job (
    id               bigint        GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    deck_id          bigint        NOT NULL REFERENCES vocab_deck(id),
    file_path        varchar(500)  NOT NULL,
    file_size        bigint        NOT NULL,
    status           varchar(20)   NOT NULL
        CHECK (status IN ('PENDING','RUNNING','COMPLETED','FAILED')),
    -- Crash-resume checkpoint: exact file byte offset at last committed batch boundary.
    processed_offset bigint        NOT NULL DEFAULT 0,
    processed_count  bigint        NOT NULL DEFAULT 0,
    inserted_count   bigint        NOT NULL DEFAULT 0,
    skipped_count    bigint        NOT NULL DEFAULT 0,
    error_count      bigint        NOT NULL DEFAULT 0,
    -- Lease/heartbeat: which worker owns the job + last liveness write (for stale-reclaim sweep).
    worker_id        varchar(100)  NULL,
    heartbeat_at     timestamptz   NULL,
    created_at       timestamptz   NOT NULL DEFAULT now(),
    updated_at       timestamptz   NOT NULL DEFAULT now()
);

-- Recovery/sweeper scans by status (PENDING or stale RUNNING).
CREATE INDEX idx_vocab_import_job_status ON vocab_import_job(status);

CREATE TABLE IF NOT EXISTS vocab_import_error (
    id          bigint        GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    job_id      bigint        NOT NULL REFERENCES vocab_import_job(id) ON DELETE CASCADE,
    line_no     bigint        NOT NULL,
    raw_excerpt varchar(500)  NULL,
    reason      varchar(255)  NOT NULL,
    created_at  timestamptz   NOT NULL DEFAULT now()
);

CREATE INDEX idx_vocab_import_error_job ON vocab_import_error(job_id);

-- Defensive dedupe BEFORE the unique index (keep lowest id per (deck_id, term)).
-- V4 seed has no dupes today → deletes 0 rows; required so the unique index builds in any env.
DELETE FROM vocab_word w
USING vocab_word d
WHERE w.deck_id = d.deck_id
  AND w.term = d.term
  AND w.id > d.id;

-- Enables INSERT ... ON CONFLICT (deck_id, term) DO NOTHING in the batch upserter.
CREATE UNIQUE INDEX uq_vocab_word_deck_term ON vocab_word(deck_id, term);
</file>

<file path="engly-be/src/main/resources/db/migration/V6__create_users_and_auth.sql">
-- V6: Local app-owned authentication.
-- The app now issues its own JWTs (email/password sign-up) and uses OPEN-GATE only as an SSO
-- option. Identity is now persisted locally instead of read entirely from OPEN-GATE claims.
--
-- app_user        — one row per account (password and/or SSO). `sub` is the canonical user key.
-- app_user_role   — Spring-form roles per user (ROLE_USER, ROLE_ADMIN), the single RBAC source.
-- refresh_token   — hashed, rotating refresh tokens for the httpOnly-cookie session.
--
-- Canonical key note: `sub` is what flows into the app JWT subject and is what the existing
-- study tables (user_card_state.user_sub, user_study_settings.user_sub) are keyed by. Password
-- users get a generated sub; SSO users keep OPEN-GATE's sub so prior study progress stays linked.

CREATE TABLE IF NOT EXISTS app_user (
    id            uuid          PRIMARY KEY DEFAULT gen_random_uuid(),
    sub           varchar(100)  NOT NULL,
    email         varchar(255)  NOT NULL,
    password_hash varchar(255)  NULL,            -- NULL for SSO-only accounts (no local password)
    display_name  varchar(255)  NULL,
    email_verified boolean      NOT NULL DEFAULT false,
    created_at    timestamptz   NOT NULL DEFAULT now(),
    updated_at    timestamptz   NOT NULL DEFAULT now(),
    CONSTRAINT uq_app_user_sub   UNIQUE (sub),
    CONSTRAINT uq_app_user_email UNIQUE (email)
);

CREATE TABLE IF NOT EXISTS app_user_role (
    user_id uuid        NOT NULL REFERENCES app_user(id) ON DELETE CASCADE,
    role    varchar(50) NOT NULL,
    CONSTRAINT pk_app_user_role PRIMARY KEY (user_id, role)
);

CREATE TABLE IF NOT EXISTS refresh_token (
    id         uuid         PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id    uuid         NOT NULL REFERENCES app_user(id) ON DELETE CASCADE,
    token_hash varchar(255) NOT NULL,            -- SHA-256 of the opaque token; raw value never stored
    expires_at timestamptz  NOT NULL,
    revoked    boolean      NOT NULL DEFAULT false,
    created_at timestamptz  NOT NULL DEFAULT now(),
    CONSTRAINT uq_refresh_token_hash UNIQUE (token_hash)
);

-- Fast lookup of a user's live refresh tokens (rotation + logout revocation).
CREATE INDEX idx_refresh_token_user ON refresh_token(user_id);
</file>

<file path="engly-be/src/main/resources/db/migration/V7__add_app_user_avatar_key.sql">
-- S3 object key of the user's current avatar ORIGINAL upload
-- (shape: avatars/{user_id}/{upload_id}/original). NULL = no avatar set.
-- Resized WebP variants (256.webp, 64.webp) live at deterministic sibling keys
-- written by the avatar-resize Lambda; only the original's key is persisted.
ALTER TABLE app_user ADD COLUMN avatar_key varchar(512) NULL;
</file>

