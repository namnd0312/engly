<file path="engly-fe/src/app/core/auth-refresh.interceptor.ts">
import { HttpInterceptorFn, HttpRequest, HttpHandlerFn, HttpErrorResponse } from '@angular/common/http';
import { inject } from '@angular/core';
import { throwError, catchError, switchMap } from 'rxjs';
import { AuthService } from './auth.service';

/** Paths that must never trigger a refresh-retry (would cause infinite loop or are pointless). */
const SKIP_REFRESH_PATHS = [
  '/api/auth/login',
  '/api/auth/register',
  '/api/auth/refresh',
  '/api/auth/verify-email',
  '/api/auth/resend-verification',
  '/api/me',
];

function shouldAttemptRefresh(req: HttpRequest<unknown>): boolean {
  if (!req.url.startsWith('/api/')) return false;
  return !SKIP_REFRESH_PATHS.some((path) => req.url.startsWith(path));
}

/**
 * On a 401 response for an /api/** request (excluding login, register, refresh, and /api/me):
 *  1. Call auth.refresh() once to rotate the access cookie.
 *  2. Retry the original request with the new cookie.
 *  3. If refresh itself fails → set anonymous state and let the error propagate so guards redirect
 *     to /login.
 *
 * Loop prevention: SKIP_REFRESH_PATHS excludes /api/auth/refresh, so the refresh call itself
 * never re-enters this interceptor's retry branch. The retry also passes through this interceptor
 * but any subsequent 401 propagates directly (no second refresh attempt) because the retried
 * request is not wrapped in catchError again.
 */
export const authRefreshInterceptor: HttpInterceptorFn = (
  req: HttpRequest<unknown>,
  next: HttpHandlerFn,
) => {
  const auth = inject(AuthService);

  return next(req).pipe(
    catchError((err: unknown) => {
      if (
        err instanceof HttpErrorResponse &&
        err.status === 401 &&
        shouldAttemptRefresh(req)
      ) {
        return auth.refresh().pipe(
          switchMap(() => next(req)),
          catchError((refreshErr: unknown) => {
            // Refresh failed — session is truly expired. Set anonymous so guards redirect.
            auth.logout();
            return throwError(() => refreshErr);
          }),
        );
      }
      return throwError(() => err);
    }),
  );
};
</file>

<file path="engly-fe/src/app/core/auth.guard.spec.ts">
import { TestBed } from '@angular/core/testing';
import { ActivatedRouteSnapshot, Router, RouterStateSnapshot } from '@angular/router';
import { provideRouter } from '@angular/router';
import { authGuard } from './auth.guard';
import { AuthService } from './auth.service';

/**
 * Specs for the generic authGuard (CanActivateFn).
 * Contract:
 *  - authenticated → returns true (allow navigation).
 *  - anonymous     → returns UrlTree pointing to /login?returnUrl=... (block navigation).
 */

class FakeAuthService {
  private _authenticated = false;
  private _loadPromise = Promise.resolve();

  setAuthenticated(v: boolean): void { this._authenticated = v; }
  ensureLoaded(): Promise<void> { return this._loadPromise; }
  isAuthenticated(): boolean { return this._authenticated; }
}

describe('authGuard', () => {
  let auth: FakeAuthService;
  let router: Router;

  beforeEach(() => {
    auth = new FakeAuthService();
    TestBed.configureTestingModule({
      providers: [
        provideRouter([]),
        { provide: AuthService, useValue: auth },
      ],
    });
    router = TestBed.inject(Router);
  });

  const route = {} as ActivatedRouteSnapshot;

  function makeState(url: string): RouterStateSnapshot {
    return { url } as RouterStateSnapshot;
  }

  function run(url = '/study') {
    return TestBed.runInInjectionContext(
      () => authGuard(route, makeState(url)),
    );
  }

  it('allows navigation when user is authenticated', async () => {
    auth.setAuthenticated(true);
    await expectAsync(run()).toBeResolvedTo(true);
  });

  it('returns a UrlTree to /login when anonymous', async () => {
    auth.setAuthenticated(false);
    const result = await run('/study');
    expect(result).toBeInstanceOf(Object);
    // UrlTree serialises to /login?returnUrl=%2Fstudy
    const serialized = router.serializeUrl(result as ReturnType<Router['parseUrl']>);
    expect(serialized).toContain('/login');
    expect(serialized).toContain('returnUrl');
  });

  it('awaits ensureLoaded() before checking authentication', async () => {
    let resolve!: () => void;
    const slowPromise = new Promise<void>((r) => { resolve = r; });
    auth['_loadPromise'] = slowPromise;
    auth.setAuthenticated(true);

    const guardPromise = run();
    resolve();
    const result = await guardPromise;
    expect(result).toBeTrue();
  });
});
</file>

