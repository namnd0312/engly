<section class="verb-search-page">
  <h1 class="page-title">Irregular Verb Search</h1>

  <div class="search-box-wrapper">
    <input
      type="search"
      class="search-input"
      placeholder="Search verbs (e.g. go, run, be)…"
      [formControl]="searchControl"
      aria-label="Search irregular verbs"
    />
  </div>

  @if (loading()) {
    <p class="state-msg loading-msg">Loading…</p>
  }

  @if (error()) {
    <p class="state-msg error-msg" role="alert">{{ error() }}</p>
  }

  @if (!loading() && !error() && results().length === 0) {
    <p class="state-msg empty-msg">No verbs found. Try a different search term.</p>
  }

  @if (results().length > 0) {
    <p class="result-count">{{ totalElements() }} verb(s) found</p>
    <div class="table-wrapper">
      <table class="verbs-table">
        <thead>
          <tr>
            <th>Base Form</th>
            <th>Past Simple</th>
            <th>Past Participle</th>
            <th>IPA Base</th>
            <th>IPA Past</th>
            <th>IPA PP</th>
            <th>Meaning (VI)</th>
          </tr>
        </thead>
        <tbody>
          @for (verb of results(); track verb.baseForm) {
            <tr class="verb-row">
              <td>
                <a class="verb-link" [routerLink]="['/verbs', verb.baseForm]">
                  {{ verb.baseForm }}
                </a>
              </td>
              <td>
                {{ verb.pastSimple }}
                @if (verb.pastSimpleAlt) {
                  <span class="alt"> / {{ verb.pastSimpleAlt }}</span>
