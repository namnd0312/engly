import { Component, inject, signal } from '@angular/core';
import { Router, RouterLink } from '@angular/router';
import { FormsModule } from '@angular/forms';
import { AuthService } from '../../core/auth.service';
import { SocialLoginButtonsComponent } from './social-login-buttons.component';

/**
 * New account registration page.
 * Route: /register (public — no guard).
 * On success shows a "check your inbox" confirmation (no session is issued yet — the account must
 * be activated via the emailed link first). Handles 409 (email taken) and 400 (validation) errors.
 */
@Component({
  selector: 'app-register-page',
  standalone: true,
  imports: [FormsModule, RouterLink, SocialLoginButtonsComponent],
  template: `
    <section class="auth-page">
      @if (!submitted()) {
        <h1 class="page-title">Đăng ký tài khoản</h1>

        <form class="auth-form" (ngSubmit)="submit()" #f="ngForm" novalidate>
          <label class="field-label" for="displayName">Tên hiển thị</label>
          <input
            id="displayName"
            class="field-input"
            type="text"
            name="displayName"
            [(ngModel)]="displayName"
            required
            autocomplete="name"
            placeholder="Nguyễn Văn A"
          />

          <label class="field-label" for="email">Email</label>
          <input
            id="email"
            class="field-input"
            type="email"
            name="email"
            [(ngModel)]="email"
            required
            autocomplete="email"
            placeholder="ban@example.com"
          />

          <label class="field-label" for="password">Mật khẩu</label>
          <input
            id="password"
            class="field-input"
            type="password"
            name="password"
            [(ngModel)]="password"
            required
            autocomplete="new-password"
            placeholder="••••••••"
          />

          @if (errorMessage()) {
            <p class="error-msg" role="alert">{{ errorMessage() }}</p>
          }

          <button type="submit" class="btn btn-primary" [disabled]="loading()">
            {{ loading() ? 'Đang đăng ký…' : 'Đăng ký' }}
          </button>
        </form>

        <app-social-login-buttons />

        <p class="switch-link">
          Đã có tài khoản? <a routerLink="/login">Đăng nhập</a>
        </p>
      } @else {
        <h1 class="page-title">Kiểm tra hộp thư của bạn</h1>
        <p class="confirm-msg">
          Chúng tôi đã gửi email kích hoạt tới <strong>{{ submittedEmail() }}</strong>. Vui lòng
          nhấn vào liên kết trong email để kích hoạt tài khoản.
        </p>

        <button type="button" class="btn btn-secondary" (click)="resend()" [disabled]="resending()">
          {{ resending() ? 'Đang gửi lại…' : 'Gửi lại email' }}
        </button>

        @if (resendMessage()) {
          <p class="hint-msg">{{ resendMessage() }}</p>
        }

        <p class="switch-link">
          Đã có tài khoản? <a routerLink="/login">Đăng nhập</a>
        </p>
      }
    </section>
  `,
  styles: [
    `
      .auth-page {
        max-width: 400px;
        margin: 4rem auto;
        padding: 2rem 1.5rem;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        font-family: system-ui, sans-serif;
      }

      .page-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a1a2e;
        margin: 0 0 1.5rem;
        text-align: center;
      }

      .auth-form {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .field-label {
        font-size: 0.875rem;
        font-weight: 600;
        color: #374151;
        margin-top: 0.5rem;
      }

      .field-input {
        padding: 0.55rem 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font: inherit;
        font-size: 0.95rem;
        outline: none;
        transition: border-color 0.15s;
      }

      .field-input:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.15);
      }

      .error-msg {
        color: #b91c1c;
        font-size: 0.875rem;
        margin: 0.25rem 0 0;
      }

      .confirm-msg {
        color: #374151;
        font-size: 0.95rem;
        line-height: 1.5;
        text-align: center;
        margin: 0 0 1.5rem;
      }

      .hint-msg {
        color: #64748b;
        font-size: 0.875rem;
        text-align: center;
        margin: 0.75rem 0 0;
      }

      .btn-secondary {
        width: 100%;
        background: #eef2ff;
        color: #4f46e5;
      }

      .btn-secondary:hover:not(:disabled) {
        background: #e0e7ff;
      }

      .btn {
        margin-top: 1rem;
        padding: 0.6rem 1rem;
        border: none;
        border-radius: 6px;
        font: inherit;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        transition: background 0.15s;
      }

      .btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }

      .btn-primary {
        background: #4f46e5;
        color: #fff;
      }

      .btn-primary:hover:not(:disabled) {
        background: #4338ca;
      }

      .switch-link {
        margin-top: 1.25rem;
        text-align: center;
        font-size: 0.875rem;
        color: #64748b;
      }

      .switch-link a {
        color: #4f46e5;
        font-weight: 600;
        text-decoration: none;
      }

      .switch-link a:hover {
        text-decoration: underline;
      }
    `,
  ],
})
export class RegisterPageComponent {
  private readonly auth = inject(AuthService);
  private readonly router = inject(Router);

  displayName = '';
  email = '';
  password = '';
  readonly loading = signal(false);
  readonly errorMessage = signal<string | null>(null);

  readonly submitted = signal(false);
  readonly submittedEmail = signal('');
  readonly resending = signal(false);
  readonly resendMessage = signal<string | null>(null);

  submit(): void {
    this.errorMessage.set(null);
    if (!this.displayName || !this.email || !this.password) {
      this.errorMessage.set('Vui lòng điền đầy đủ thông tin.');
      return;
    }

    this.loading.set(true);
    this.auth.register(this.email, this.password, this.displayName).subscribe({
      next: () => {
        this.loading.set(false);
        if (this.auth.isAuthenticated()) {
          // Kill-switch (EMAIL_VERIFICATION_ENABLED=false): a session was issued immediately —
          // land like a normal login instead of showing a bogus "check your inbox" screen.
          void this.router.navigate(['/']);
          return;
        }
        this.submittedEmail.set(this.email);
        this.submitted.set(true);
      },
      error: (err: { status?: number; error?: { message?: string } }) => {
        this.loading.set(false);
        if (err?.status === 409) {
          this.errorMessage.set('Email này đã được sử dụng. Vui lòng dùng email khác.');
        } else if (err?.status === 400) {
          const msg = err?.error?.message;
          this.errorMessage.set(msg ?? 'Thông tin không hợp lệ. Vui lòng kiểm tra lại.');
        } else {
          this.errorMessage.set('Đăng ký thất bại. Vui lòng thử lại.');
        }
      },
    });
  }

  resend(): void {
    this.resending.set(true);
    this.resendMessage.set(null);
    this.auth.resendVerification(this.submittedEmail()).subscribe({
      next: () => {
        this.resending.set(false);
        this.resendMessage.set('Nếu email hợp lệ, chúng tôi đã gửi lại liên kết kích hoạt.');
      },
      error: () => {
        this.resending.set(false);
        this.resendMessage.set('Nếu email hợp lệ, chúng tôi đã gửi lại liên kết kích hoạt.');
      },
    });
  }
}
</file>

