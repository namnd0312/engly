<file path="engly-be/src/main/java/com/engly/identity/application/EmailVerificationService.java">
package com.engly.identity.application;

import com.engly.identity.config.EmailVerificationProperties;
import com.engly.identity.domain.EmailVerificationToken;
import com.engly.identity.domain.InvalidVerificationTokenException;
import com.engly.identity.domain.UserAccount;
import com.engly.identity.infrastructure.EmailVerificationTokenRepository;
import com.engly.identity.infrastructure.UserAccountRepository;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import org.springframework.transaction.support.TransactionSynchronization;
import org.springframework.transaction.support.TransactionSynchronizationManager;

import java.security.SecureRandom;
import java.time.Instant;
import java.util.Base64;
import java.util.Optional;

/**
 * Owns the email-activation-on-registration flow: issue a token + send the link, verify a raw
 * token, and resend with cooldown. See {@code EmailVerificationProperties#enabled} for the
 * rollback kill-switch (caller decides what to do when disabled — see {@code AuthController}).
 */
@Service
public class EmailVerificationService {

    private final EmailVerificationTokenRepository tokens;
    private final UserAccountRepository users;
    private final ActivationEmailSender sender;
    private final EmailVerificationProperties props;
    private final SecureRandom random = new SecureRandom();

    public EmailVerificationService(EmailVerificationTokenRepository tokens, UserAccountRepository users,
                                    ActivationEmailSender sender, EmailVerificationProperties props) {
        this.tokens = tokens;
        this.users = users;
        this.sender = sender;
        this.props = props;
    }

    /**
     * Invalidate any prior tokens, mint a fresh one, and dispatch the activation email after this
     * transaction commits (never block a DB connection on SMTP; never email a link for a row that
     * then rolls back). No-op if the user has no email (password accounts always do).
     */
    @Transactional
    public void startVerification(UserAccount user) {
        if (user.getEmail() == null) {
            return;
        }
        tokens.deleteByUserId(user.getId());

        byte[] bytes = new byte[32];
        random.nextBytes(bytes);
        String rawToken = Base64.getUrlEncoder().withoutPadding().encodeToString(bytes);
        Instant expiresAt = Instant.now().plus(props.tokenTtl());
        tokens.save(new EmailVerificationToken(user.getId(), TokenHashing.sha256(rawToken), expiresAt));

        String email = user.getEmail();
        TransactionSynchronizationManager.registerSynchronization(new TransactionSynchronization() {
            @Override
            public void afterCommit() {
                sender.send(email, rawToken);
            }
        });
    }

    /** Rollback kill-switch state — see {@code AuthController.register}. */
    public boolean isEnabled() {
        return props.enabled();
    }

    /**
     * Used only when the gate is disabled: activate the account immediately, bypassing the token
     * flow. Re-fetches by id and mutates the managed instance (dirty-checking flushes it) rather
     * than {@code save()}-ing the caller's entity directly — that entity crossed a transaction
     * boundary (returned from {@code UserAccountService.register}'s already-committed transaction),
     * so merging it back would overwrite DB-managed columns (e.g. {@code updated_at}) with the
     * stale/never-fetched values it held at that point.
     */
    @Transactional
    public void markVerifiedImmediately(UserAccount user) {
        users.findById(user.getId()).ifPresent(UserAccount::markEmailVerified);
    }

    /** Atomically consumes the token and activates the account. Throws on invalid/expired/used. */
    @Transactional
    public UserAccount verify(String rawToken) {
        Instant now = Instant.now();
        int consumed = tokens.consumeIfUsable(TokenHashing.sha256(rawToken), now);
        if (consumed == 0) {
            throw new InvalidVerificationTokenException();
        }
        EmailVerificationToken token = tokens.findByTokenHash(TokenHashing.sha256(rawToken))
                .orElseThrow(InvalidVerificationTokenException::new);
        UserAccount user = users.findById(token.getUserId())
                .orElseThrow(InvalidVerificationTokenException::new);
        user.markEmailVerified();
        return user;
    }

    /**
     * Generic: silently no-ops for an unknown/already-verified email or one still in cooldown — never
     * reveals account existence. Otherwise issues a fresh token (invalidating the prior one).
     */
    @Transactional
    public void resend(String email) {
        Optional<UserAccount> match = users.findByEmail(EmailNormalizer.normalize(email));
        if (match.isEmpty() || match.get().isEmailVerified()) {
            return;
        }
        UserAccount user = match.get();
        Optional<EmailVerificationToken> lastToken = tokens.findFirstByUserIdOrderByCreatedAtDesc(user.getId());
        if (lastToken.isPresent()) {
            Instant cooldownEnds = lastToken.get().getCreatedAt().plus(props.resendCooldown());
            if (Instant.now().isBefore(cooldownEnds)) {
                return;
            }
        }
        startVerification(user);
    }
}
</file>

<file path="engly-be/src/main/java/com/engly/identity/application/ProfileService.java">
package com.engly.identity.application;

import com.engly.identity.api.dto.UserInfoResponse;
import com.engly.identity.domain.InvalidAvatarException;
import com.engly.identity.domain.UserAccount;
import com.engly.identity.infrastructure.S3AvatarStorage;
import com.engly.identity.infrastructure.S3AvatarStorage.PresignedUpload;
import com.engly.identity.infrastructure.UserAccountRepository;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.Set;
import java.util.UUID;
import java.util.regex.Pattern;

/**
 * Self-service profile: display-name edits and the avatar upload lifecycle.
 *
 * <p>Avatar flow: {@link #createAvatarUploadUrl} mints a presigned PUT for a key the BACKEND
 * generates (client never chooses keys) → browser uploads directly to S3 → {@link #confirmAvatar}
 * re-validates ownership/shape/existence and persists the key. The resize Lambda then writes
 * 256/64 WebP variants next to the original; {@link #toUserInfo} serves those when present and
 * falls back to the original until they appear.
 */
@Service
public class ProfileService {

    /** Only browser-renderable raster formats; signed into the PUT so S3 enforces it. */
    private static final Set<String> ALLOWED_CONTENT_TYPES =
            Set.of("image/jpeg", "image/png", "image/webp", "image/gif");

    /** avatars/{userId}/{uploadId}/original — both ids are UUIDs. */
    private static final Pattern KEY_SHAPE =
            Pattern.compile("^avatars/[0-9a-f-]{36}/[0-9a-f-]{36}/original$");

    private final UserAccountRepository users;
    private final S3AvatarStorage storage;

    public ProfileService(UserAccountRepository users, S3AvatarStorage storage) {
        this.users = users;
        this.storage = storage;
    }

    @Transactional
    public UserAccount updateDisplayName(String sub, String displayName) {
        UserAccount user = requireUser(sub);
        user.updateDisplayName(displayName.trim());
        return user;
    }

    @Transactional(readOnly = true)
    public PresignedUpload createAvatarUploadUrl(String sub, String contentType) {
        if (contentType == null || !ALLOWED_CONTENT_TYPES.contains(contentType.toLowerCase())) {
            throw new InvalidAvatarException(
                    "Unsupported avatar content type; allowed: " + ALLOWED_CONTENT_TYPES);
        }
        UserAccount user = requireUser(sub);
        String objectKey = "avatars/" + user.getId() + "/" + UUID.randomUUID() + "/original";
        return storage.presignUpload(objectKey, contentType.toLowerCase());
    }

    @Transactional
    public UserAccount confirmAvatar(String sub, String objectKey) {
        UserAccount user = requireUser(sub);
        // Ownership: the key must sit under the caller's own prefix (backend generated it there).
        if (!objectKey.startsWith("avatars/" + user.getId() + "/") || !KEY_SHAPE.matcher(objectKey).matches()) {
            throw new InvalidAvatarException("Object key does not belong to the current user");
        }
        // Existence + the stored Content-Type must still be an allowed image type.
        String storedType = storage.contentTypeOf(objectKey)
                .orElseThrow(() -> new InvalidAvatarException("No uploaded object found for this key"));
        if (!ALLOWED_CONTENT_TYPES.contains(storedType.toLowerCase())) {
            throw new InvalidAvatarException("Uploaded object is not an allowed image type");
        }
        user.changeAvatar(objectKey);
        return user;
    }

    /**
     * Identity projection with presigned avatar URLs. One HeadObject decides whether the resized
     * variants exist yet; until then the original serves both slots (graceful pre-Lambda window).
     */
    @Transactional(readOnly = true)
    public UserInfoResponse toUserInfo(UserAccount user, boolean isAdmin) {
        String avatarKey = user.getAvatarKey();
        if (avatarKey == null) {
            return new UserInfoResponse(user.getEmail(), user.getDisplayName(),
                    isAdmin, null, null);
        }
        String base = avatarKey.substring(0, avatarKey.length() - "/original".length());
        String avatarUrl;
        String thumbUrl;
        if (storage.exists(base + "/256.webp")) {
            avatarUrl = storage.presignDownload(base + "/256.webp");
            thumbUrl = storage.presignDownload(base + "/64.webp");
        } else {
            String original = storage.presignDownload(avatarKey);
            avatarUrl = original;
            thumbUrl = original;
        }
        return new UserInfoResponse(user.getEmail(), user.getDisplayName(),
                isAdmin, avatarUrl, thumbUrl);
    }

    private UserAccount requireUser(String sub) {
        return users.findBySub(sub)
                .orElseThrow(() -> new InvalidAvatarException("No local account for current user"));
    }
}
</file>

<file path="engly-be/src/main/java/com/engly/identity/application/SocialAccountCreator.java">
package com.engly.identity.application;

import com.engly.identity.domain.UserAccount;
import com.engly.identity.domain.UserIdentity;
import com.engly.identity.infrastructure.UserAccountRepository;
import com.engly.identity.infrastructure.UserIdentityRepository;
import org.springframework.stereotype.Component;
import org.springframework.transaction.annotation.Propagation;
import org.springframework.transaction.annotation.Transactional;

import java.util.UUID;

/**
 * Creates a brand-new social account + its provider link in an isolated {@code REQUIRES_NEW}
 * transaction. Isolation matters: on a concurrent first login the unique constraint
 * ({@code uq_identity_provider_subject} / {@code uq_app_user_email}) fires and marks THIS transaction
 * rollback-only. Running it in its own transaction means only this insert rolls back, leaving the
 * caller's transaction clean to re-resolve — catching the violation inside a shared transaction would
 * instead die at commit with {@code UnexpectedRollbackException}.
 *
 * <p>Separate bean (not a private method on {@link SocialLoginService}) so the {@code REQUIRES_NEW}
 * proxy actually applies — self-invocation would bypass it.
 */
@Component
public class SocialAccountCreator {

    private final UserAccountRepository users;
    private final UserIdentityRepository identities;

    public SocialAccountCreator(UserAccountRepository users, UserIdentityRepository identities) {
        this.users = users;
        this.identities = identities;
    }

    /**
     * New social user (fresh sub, no password) + its provider identity link.
     *
     * @param accountEmail  email to set on the new {@code app_user} — null when the provider email is
     *                      absent or already owned by another account (the unique {@code app_user.email}
     *                      forbids duplicating it; the caller decides).
     * @param identityEmail email seen from the provider, recorded on the identity row for audit (may be null).
     */
    @Transactional(propagation = Propagation.REQUIRES_NEW)
    public UserAccount create(String provider, String providerUserId, String accountEmail,
                              String identityEmail, String displayName, boolean emailVerified) {
        UserAccount user = users.save(
                UserAccount.ssoUser("sso-" + UUID.randomUUID(), accountEmail, displayName, emailVerified));
        identities.save(UserIdentity.link(user.getId(), provider, providerUserId, identityEmail));
        return user;
    }
}
</file>

<file path="engly-be/src/main/java/com/engly/identity/application/SsoAuthenticationSuccessHandler.java">
package com.engly.identity.application;

import com.engly.identity.domain.UserAccount;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import jakarta.servlet.http.HttpSession;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.security.core.Authentication;
import org.springframework.security.oauth2.client.authentication.OAuth2AuthenticationToken;
import org.springframework.security.oauth2.core.user.OAuth2User;
import org.springframework.security.web.authentication.AuthenticationSuccessHandler;
import org.springframework.stereotype.Component;

import java.io.IOException;

/**
 * Bridges a completed Google/Facebook handshake into the app's own session: resolve/link the
 * {@link UserAccount}, mint the app JWT cookies via {@link AuthTokenService} (identical to password
 * login), drop the throwaway OAuth handshake session, and redirect to the SPA.
 *
 * <p>The redirect target is always the server-side {@code app.frontend-url} — never a request-supplied
 * value — so this cannot become an open redirect.
 */
@Component
public class SsoAuthenticationSuccessHandler implements AuthenticationSuccessHandler {

    private final SocialLoginService socialLoginService;
    private final AuthTokenService authTokenService;
    private final String frontendUrl;

    public SsoAuthenticationSuccessHandler(SocialLoginService socialLoginService,
                                           AuthTokenService authTokenService,
                                           @Value("${app.frontend-url}") String frontendUrl) {
        this.socialLoginService = socialLoginService;
        this.authTokenService = authTokenService;
        this.frontendUrl = frontendUrl;
    }

    @Override
    public void onAuthenticationSuccess(HttpServletRequest request, HttpServletResponse response,
                                        Authentication authentication) throws IOException {
        OAuth2AuthenticationToken token = (OAuth2AuthenticationToken) authentication;
        String provider = token.getAuthorizedClientRegistrationId();
        OAuth2User principal = token.getPrincipal();

        UserAccount user = socialLoginService.resolveOrLink(provider, principal);
        authTokenService.issueSession(user, response);

        // The OAuth handshake session existed only to carry the authorization request; discard it so
        // the app stays effectively stateless once the JWT cookies are set.
        HttpSession session = request.getSession(false);
        if (session != null) {
            session.invalidate();
        }

        response.sendRedirect(homeUrl());
    }

    private String homeUrl() {
        String base = frontendUrl.endsWith("/") ? frontendUrl.substring(0, frontendUrl.length() - 1) : frontendUrl;
        return base + "/";
    }
}
