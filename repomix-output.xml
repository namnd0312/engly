<section class="admin-list-page">
  <nav class="admin-nav">
    <span class="admin-nav-label">Admin sections:</span>
    <a class="admin-nav-link active" [routerLink]="['/admin']">Irregular Verbs</a>
    <a class="admin-nav-link" [routerLink]="['/admin/decks']">Vocab Decks</a>
    <a class="admin-nav-link" [routerLink]="['/admin/vocab-words']">Vocab Words</a>
    <a class="admin-nav-link" [routerLink]="['/admin/vocab-imports']">Import Vocabulary (CSV)</a>
  </nav>

  <div class="page-head">
    <h1 class="page-title">Manage Irregular Verbs</h1>
    <button type="button" class="primary-btn" (click)="goNew()">+ New verb</button>
  </div>

  <div class="search-box-wrapper">
    <input
      type="search"
      class="search-input"
      placeholder="Search verbs (base form or meaning)…"
      [formControl]="searchControl"
      aria-label="Search verbs"
    />
  </div>

  @if (loading()) {
    <p class="state-msg loading-msg">Loading…</p>
  }

  @if (error()) {
    <p class="state-msg error-msg" role="alert">{{ error() }}</p>
  }

  @if (!loading() && !error() && verbs().length === 0) {
    <p class="state-msg empty-msg">No verbs found.</p>
  }

  @if (verbs().length > 0) {
    <p class="result-count">{{ totalElements() }} verb(s)</p>
    <div class="table-wrapper">
      <table class="verbs-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Base</th>
            <th>Past Simple</th>
            <th>Past Participle</th>
            <th>Meaning (VI)</th>
            <th>Verified</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          @for (verb of verbs(); track verb.id) {
            <tr class="verb-row">
              <td>{{ verb.id }}</td>
              <td>{{ verb.baseForm }}</td>
              <td>
                {{ verb.pastSimple }}
                @if (verb.pastSimpleAlt) {
                  <span class="alt"> / {{ verb.pastSimpleAlt }}</span>
                }
              </td>
              <td>
                {{ verb.pastParticiple }}
                @if (verb.pastParticipleAlt) {
                  <span class="alt"> / {{ verb.pastParticipleAlt }}</span>
                }
              </td>
              <td class="meaning">{{ verb.meaningVi }}</td>
              <td>
                <label class="toggle">
                  <input
                    type="checkbox"
                    [checked]="verb.verified"
                    (change)="onToggle(verb)"
                    [attr.aria-label]="'Toggle verified for ' + verb.baseForm"
                  />
                </label>
              </td>
              <td class="actions">
                <button type="button" class="link-btn" (click)="goEdit(verb.id)">Edit</button>
                <button type="button" class="link-btn danger" (click)="onDelete(verb)">Delete</button>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</section>

