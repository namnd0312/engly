<file path="engly-be/pom.xml">
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>com.engly</groupId>
    <artifactId>engly</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>engly</name>
    <description>Engly — irregular-verb lookup backend</description>

    <properties>
        <java.version>21</java.version>
        <!-- Override Boot-managed TC (3.4.x → 1.20.x): 1.21.0 fixes OrbStack Docker API
             negotiation (TC 1.20.x hardcodes API 1.32; OrbStack requires >= 1.40). -->
        <testcontainers.version>1.21.0</testcontainers.version>
        <!-- JUnit5 tag filter for surefire; empty = run all. `unit-only` profile overrides. -->
        <test.excludedGroups></test.excludedGroups>
        <!-- Provisional JaCoCo gate floors; phase-06 re-pins from measured baseline. -->
        <jacoco.line.min>0.65</jacoco.line.min>
        <jacoco.branch.min>0.55</jacoco.branch.min>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- AWS SDK v2 (S3 + presigner for avatar uploads). BOM keeps artifact versions aligned. -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>2.25.70</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <!-- SMTP dispatch for account-activation emails (provider-agnostic JavaMailSender). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- Stateless Bearer JWT validation for /api/admin/** (OAuth2 Resource Server). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- tus resumable upload server: disk-backed chunk store (buffers to disk, not RAM) →
             safe at 512MB heap for GB-scale CSV uploads. Jakarta/Servlet 6, Java 17+. -->
        <dependency>
            <groupId>me.desair.tus</groupId>
            <artifactId>tus-java-server</artifactId>
            <version>1.0.0-3.0</version>
        </dependency>
        <!-- Single-line, quote-aware CSV field parsing in the streaming processor. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.11.0</version>
        </dependency>
        <!-- S3 client + request presigner for avatar storage (endpoint-overridable: local
             emulator in dev, real AWS in prod). Version from the awssdk BOM above. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- OrbStack requires Docker API >= 1.40; TC defaults to 1.32.
                         Override the shaded docker-java config via JVM system property. -->
                    <systemPropertyVariables>
                        <api.version>1.44</api.version>
                    </systemPropertyVariables>
                    <!-- Disable Ryuk reaper to avoid a second Docker connection attempt. -->
                    <environmentVariables>
                        <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
                    </environmentVariables>
                    <!-- JUnit5 tag filter. Default empty (run all). The `unit-only` profile
                         sets this to `integration` so the Testcontainers-backed tests are
                         skipped when Docker/OrbStack is not running.
                         Do NOT hardcode <argLine> here — JaCoCo's prepare-agent injects via
                         ${argLine}; overriding it would silently disable coverage. -->
                    <excludedGroups>${test.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
            <!-- JaCoCo Code Coverage. Version pinned: spring-boot-starter-parent does NOT
                 manage jacoco-maven-plugin. prepare-agent (initialize) sets ${argLine};
                 report + check run at verify. Excludes kept byte-identical in both. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <destFile>${project.build.directory}/jacoco.exec</destFile>
                            <append>true</append>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco.exec</dataFile>
                            <outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
                            <excludes>
                                <exclude>com/engly/**/dto/**</exclude>
                                <exclude>**/*Response</exclude>
                                <exclude>**/*Request</exclude>
                                <exclude>**/SecurityConfig</exclude>
                                <exclude>**/AsyncConfig</exclude>
                                <exclude>**/TusUploadConfig</exclude>
                                <exclude>**/OidcRoleMappingConfig</exclude>
                                <exclude>**/EnglyApplication</exclude>
                                <exclude>**/S3ClientConfig*</exclude>
                                <exclude>**/AwsProperties*</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco.exec</dataFile>
                            <!-- Gate values are provisional. Phase-06 captures the real baseline
                                 (full `./mvnw verify` with Docker up) and sets the enforced floor
                                 to baseline minus a small margin. Override via -Djacoco.line.min /
                                 -Djacoco.branch.min without editing the pom. -->
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <excludes>
                                        <exclude>com/engly/**/dto/**</exclude>
                                        <exclude>**/*Response</exclude>
                                        <exclude>**/*Request</exclude>
                                        <exclude>**/SecurityConfig</exclude>
                                        <exclude>**/AsyncConfig</exclude>
                                        <exclude>**/TusUploadConfig</exclude>
                                        <exclude>**/OidcRoleMappingConfig</exclude>
                                        <exclude>**/EnglyApplication</exclude>
                                        <exclude>**/S3ClientConfig*</exclude>
                                        <exclude>**/AwsProperties*</exclude>
                                    </excludes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.min}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch.min}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Docker-free run: skips @Tag("integration") Testcontainers tests.
             Usage: ./mvnw test -Punit-only   (or: ./mvnw test -DexcludedGroups=integration) -->
        <profile>
            <id>unit-only</id>
            <properties>
                <test.excludedGroups>integration</test.excludedGroups>
            </properties>
        </profile>
    </profiles>

</project>
</file>

<file path="engly-fe/src/app/core/auth.service.spec.ts">
import { TestBed } from '@angular/core/testing';
import { provideHttpClient } from '@angular/common/http';
import {
  HttpTestingController,
  provideHttpClientTesting,
} from '@angular/common/http/testing';
import { AuthService, RegisterResult, UserInfo } from './auth.service';

const ANON_USER: UserInfo = {
  email: null, name: null, isAdmin: false, avatarUrl: null, avatarThumbUrl: null,
};
const ALICE: UserInfo = {
  email: 'a@b.com', name: 'Alice', isAdmin: false, avatarUrl: null, avatarThumbUrl: null,
};
const ADMIN: UserInfo = {
  email: 'admin@b.com', name: 'Admin', isAdmin: true, avatarUrl: null, avatarThumbUrl: null,
};

describe('AuthService', () => {
  let service: AuthService;
  let httpTesting: HttpTestingController;

  beforeEach(() => {
    TestBed.configureTestingModule({
      providers: [provideHttpClient(), provideHttpClientTesting()],
    });
    service = TestBed.inject(AuthService);
    httpTesting = TestBed.inject(HttpTestingController);
  });

  afterEach(() => httpTesting.verify());

  // ── ensureLoaded / loadMe ──────────────────────────────────────────────────

  it('loadMe() sets the user on 200 (withCredentials)', () => {
    service.loadMe();

    const req = httpTesting.expectOne('/api/me');
    expect(req.request.method).toBe('GET');
    expect(req.request.withCredentials).toBeTrue();
    req.flush(ALICE);

    expect(service.user()).toEqual(ALICE);
    expect(service.isAuthenticated()).toBeTrue();
    expect(service.isAdmin()).toBeFalse();
  });

  it('isAdmin() is true when /api/me returns isAdmin: true', () => {
    service.loadMe();
    httpTesting.expectOne('/api/me').flush(ADMIN);

    expect(service.isAdmin()).toBeTrue();
    expect(service.isAuthenticated()).toBeTrue();
  });

  it('ensureLoaded() resolves once /api/me settles and is memoized', async () => {
    const promise = service.ensureLoaded();
    // Second call must reuse the same in-flight promise (no extra request).
    expect(service.ensureLoaded()).toBe(promise);

    httpTesting.expectOne('/api/me').flush(ANON_USER);

    await expectAsync(promise).toBeResolved();
  });

  it('loadMe() recovers via one refresh-retry when the access cookie has expired', () => {
    service.loadMe();

    // Access cookie expired → first /api/me is 401.
    httpTesting
      .expectOne('/api/me')
      .flush(null, { status: 401, statusText: 'Unauthorized' });

    // Refresh cookie still valid → rotate the access cookie.
    httpTesting.expectOne('/api/auth/refresh').flush(null);

    // Retry succeeds with the fresh cookie.
    httpTesting.expectOne('/api/me').flush(ALICE);

    expect(service.user()).toEqual(ALICE);
    expect(service.isAuthenticated()).toBeTrue();
  });

  it('loadMe() stays anonymous when the refresh also fails (truly expired)', () => {
    service.loadMe();
    httpTesting
      .expectOne('/api/me')
      .flush(null, { status: 401, statusText: 'Unauthorized' });
    httpTesting
      .expectOne('/api/auth/refresh')
      .flush(null, { status: 401, statusText: 'Unauthorized' });

    expect(service.user()).toBeNull();
    expect(service.isAuthenticated()).toBeFalse();
  });

  it('loadMe() stays anonymous on a non-401 error without attempting refresh', () => {
    service.loadMe();
    httpTesting
      .expectOne('/api/me')
      .flush(null, { status: 500, statusText: 'Server Error' });

    // No refresh attempt for non-401 — verify() in afterEach asserts no stray request.
    expect(service.user()).toBeNull();
    expect(service.isAuthenticated()).toBeFalse();
  });

  // ── loginWithPassword ──────────────────────────────────────────────────────

  it('loginWithPassword() POSTs credentials and sets user on success', () => {
    let result: UserInfo | undefined;
    service.loginWithPassword('a@b.com', 'secret').subscribe((u) => (result = u));

    const req = httpTesting.expectOne('/api/auth/login');
    expect(req.request.method).toBe('POST');
    expect(req.request.withCredentials).toBeTrue();
    expect(req.request.body).toEqual({ email: 'a@b.com', password: 'secret' });
    req.flush(ALICE);

    // Background hydrate: login response has null avatar URLs, so /api/me is re-fetched.
    httpTesting.expectOne('/api/me').flush({ ...ALICE, avatarThumbUrl: 'http://s3/64.webp' });

    expect(result).toEqual(ALICE);
    expect(service.user()?.avatarThumbUrl).toBe('http://s3/64.webp');
    expect(service.isAuthenticated()).toBeTrue();
  });

  it('loginWithPassword() propagates 401 without setting user', () => {
    let err: unknown;
    service.loginWithPassword('x@y.com', 'wrong').subscribe({
      error: (e) => (err = e),
    });

    httpTesting
      .expectOne('/api/auth/login')
      .flush({ message: 'Bad credentials' }, { status: 401, statusText: 'Unauthorized' });

    expect(err).toBeTruthy();
    expect(service.user()).toBeNull();
  });

  // ── register ──────────────────────────────────────────────────────────────
  // register() no longer issues a session — the account must be activated via the emailed link
  // first (see verifyEmail() below). It only returns {email}; it must NOT set `user` or trigger
  // any follow-up /api/me call (httpTesting.verify() in afterEach catches a stray one).

  it('register() POSTs payload and does NOT set user (no session issued)', () => {
    let result: UserInfo | RegisterResult | undefined;
    service.register('a@b.com', 'pass', 'Alice').subscribe((r) => (result = r));

    const req = httpTesting.expectOne('/api/auth/register');
    expect(req.request.method).toBe('POST');
    expect(req.request.withCredentials).toBeTrue();
    expect(req.request.body).toEqual({ email: 'a@b.com', password: 'pass', displayName: 'Alice' });
    req.flush({ email: 'a@b.com' });

    expect(result).toEqual({ email: 'a@b.com' });
    expect(service.user()).toBeNull();
    expect(service.isAuthenticated()).toBeFalse();
  });

  it('register() with the kill-switch disabled (backend issues a session) sets user like login', () => {
    // Backend returns the full identity (has `isAdmin`) instead of {email} when
    // EMAIL_VERIFICATION_ENABLED=false — must be treated as an issued session, not a stray shape.
    let result: UserInfo | RegisterResult | undefined;
    service.register('a@b.com', 'pass', 'Alice').subscribe((r) => (result = r));

    httpTesting.expectOne('/api/auth/register').flush(ALICE);

    // Background hydrate via /api/me, same as loginWithPassword.
    httpTesting.expectOne('/api/me').flush(ALICE);

    expect(result).toEqual(ALICE);
    expect(service.user()).toEqual(ALICE);
    expect(service.isAuthenticated()).toBeTrue();
  });

  it('register() propagates 409 without setting user', () => {
    let err: unknown;
    service.register('taken@b.com', 'pass', 'Bob').subscribe({ error: (e) => (err = e) });

    httpTesting
      .expectOne('/api/auth/register')
      .flush({ message: 'Email taken' }, { status: 409, statusText: 'Conflict' });

    expect(err).toBeTruthy();
    expect(service.user()).toBeNull();
  });

  // ── verifyEmail ───────────────────────────────────────────────────────────

  it('verifyEmail() POSTs the token and sets user on success', () => {
    let result: UserInfo | undefined;
    service.verifyEmail('raw-token').subscribe((u) => (result = u));

    const req = httpTesting.expectOne('/api/auth/verify-email');
    expect(req.request.method).toBe('POST');
    expect(req.request.withCredentials).toBeTrue();
    expect(req.request.body).toEqual({ token: 'raw-token' });
    req.flush(ALICE);

    // Background hydrate via /api/me (same as login/register did before).
    httpTesting.expectOne('/api/me').flush(ALICE);

    expect(result).toEqual(ALICE);
    expect(service.user()).toEqual(ALICE);
    expect(service.isAuthenticated()).toBeTrue();
  });

  it('verifyEmail() propagates 400 (invalid/expired token) without setting user', () => {
    let err: unknown;
    service.verifyEmail('bad-token').subscribe({ error: (e) => (err = e) });

    httpTesting
      .expectOne('/api/auth/verify-email')
      .flush({ message: 'Invalid token' }, { status: 400, statusText: 'Bad Request' });

    expect(err).toBeTruthy();
    expect(service.user()).toBeNull();
  });

  // ── resendVerification ────────────────────────────────────────────────────

  it('resendVerification() POSTs the email to the right URL', () => {
    let completed = false;
    service.resendVerification('a@b.com').subscribe({ complete: () => (completed = true) });

    const req = httpTesting.expectOne('/api/auth/resend-verification');
    expect(req.request.method).toBe('POST');
    expect(req.request.withCredentials).toBeTrue();
    expect(req.request.body).toEqual({ email: 'a@b.com' });
    req.flush(null, { status: 202, statusText: 'Accepted' });

    expect(completed).toBeTrue();
  });

  // ── refresh ───────────────────────────────────────────────────────────────

  it('refresh() POSTs /api/auth/refresh with withCredentials', () => {
    let completed = false;
    service.refresh().subscribe({ complete: () => (completed = true) });

    const req = httpTesting.expectOne('/api/auth/refresh');
    expect(req.request.method).toBe('POST');
    expect(req.request.withCredentials).toBeTrue();
    expect(req.request.body).toBeNull();
    req.flush(null);

    expect(completed).toBeTrue();
  });

  it('refresh() de-duplicates concurrent calls into a single request', () => {
    let aDone = false;
    let bDone = false;
    service.refresh().subscribe({ complete: () => (aDone = true) });
    service.refresh().subscribe({ complete: () => (bDone = true) });

    // Both callers share one in-flight POST (prevents the refresh-rotation race → reload loop).
    const inFlight = httpTesting.match('/api/auth/refresh');
    expect(inFlight.length).toBe(1);
    inFlight[0].flush(null);
    expect(aDone).toBeTrue();
    expect(bDone).toBeTrue();

    // Once settled, a later refresh issues a fresh request.
    service.refresh().subscribe();
    httpTesting.expectOne('/api/auth/refresh').flush(null);
  });

  // ── logout ────────────────────────────────────────────────────────────────

  it('logout() POSTs /api/auth/logout, clears the user, and navigates home', () => {
    const navigate = spyOn(service as unknown as { navigate: (u: string) => void }, 'navigate');

    service.loadMe();
    httpTesting.expectOne('/api/me').flush(ALICE);
    expect(service.isAuthenticated()).toBeTrue();

    service.logout();
    const req = httpTesting.expectOne('/api/auth/logout');
    expect(req.request.method).toBe('POST');
    expect(req.request.withCredentials).toBeTrue();
    req.flush(null);

    expect(service.user()).toBeNull();
    expect(navigate).toHaveBeenCalledWith('/');
  });

  it('logout() still clears state if /api/auth/logout returns an error', () => {
    const navigate = spyOn(service as unknown as { navigate: (u: string) => void }, 'navigate');

    service.loadMe();
    httpTesting.expectOne('/api/me').flush(ALICE);

    service.logout();
    httpTesting
      .expectOne('/api/auth/logout')
      .flush(null, { status: 500, statusText: 'Server Error' });

    expect(service.user()).toBeNull();
    expect(navigate).toHaveBeenCalledWith('/');
  });

  // ── social login ──────────────────────────────────────────────────────────

  it('loginWithProvider() does a full-page navigation to the backend OAuth2 entry point', () => {
    const navigate = spyOn(service as unknown as { navigate: (u: string) => void }, 'navigate');

    service.loginWithProvider('google');
    expect(navigate).toHaveBeenCalledWith('/oauth2/authorization/google');

    service.loginWithProvider('facebook');
    expect(navigate).toHaveBeenCalledWith('/oauth2/authorization/facebook');

    // It must NOT be an XHR — no HTTP request is made.
    httpTesting.verify();
  });

  // ── setUser / refreshMe (profile feature) ─────────────────────────────────

  it('setUser() replaces the identity signal without an HTTP call', () => {
    service.setUser({ ...ALICE, name: 'Renamed', avatarUrl: 'http://s3/256.webp' });

    expect(service.user()?.name).toBe('Renamed');
    expect(service.user()?.avatarUrl).toBe('http://s3/256.webp');
    expect(service.isAuthenticated()).toBeTrue();
  });

  it('refreshMe() re-fetches /api/me even after a previous load', async () => {
    service.loadMe();
    httpTesting.expectOne('/api/me').flush(ALICE);

    const refreshed = service.refreshMe();
    httpTesting
      .expectOne('/api/me')
      .flush({ ...ALICE, avatarThumbUrl: 'http://s3/64.webp' });
    await refreshed;

    expect(service.user()?.avatarThumbUrl).toBe('http://s3/64.webp');
  });
});
