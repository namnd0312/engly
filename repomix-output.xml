<section class="import-page">
  <div class="page-head">
    <button type="button" class="ghost-btn" (click)="goBack()">← Admin</button>
    <h1 class="page-title">Import Vocabulary (CSV)</h1>
  </div>

  @if (serverError()) {
    <p class="state-msg error-msg" role="alert">{{ serverError() }}</p>
  }

  <!-- Upload form — hidden once a job is running/complete -->
  @if (!job()) {
    <div class="upload-card">
      <div class="field">
        <label class="field-label" for="deck-select">Deck</label>
        <select
          id="deck-select"
          class="field-select"
          (change)="onDeckChange($event)"
          [disabled]="uploading() || creating()"
        >
          <option value="">— choose a deck —</option>
          @for (d of decks(); track d.id) {
            <option [value]="d.id">{{ d.name }}</option>
          }
        </select>
      </div>

      <div class="field">
        <label class="field-label" for="csv-file">CSV file</label>
        <input
          id="csv-file"
          type="file"
          accept=".csv,text/csv"
          class="field-input"
          (change)="onFileChange($event)"
          [disabled]="uploading() || creating()"
        />
      </div>

      @if (uploading()) {
        <div class="progress-group">
          <div class="progress-label">Uploading… {{ uploadProgress() }}%</div>
          <div class="progress-bar-track">
            <div class="progress-bar-fill" [style.width.%]="uploadProgress()"></div>
          </div>
          <button type="button" class="ghost-btn" (click)="cancelUpload()">Cancel</button>
        </div>
      }

      @if (!uploading()) {
        <button
          type="button"
          class="primary-btn"
          [disabled]="!file() || selectedDeckId() == null || creating()"
          (click)="startUpload()"
        >
          {{ creating() ? 'Creating job…' : 'Upload & Import' }}
        </button>
      }
    </div>
  }

  <!-- Job status card -->
  @if (job(); as j) {
    <div class="job-card" [class.failed]="j.status === 'FAILED'" [class.done]="j.status === 'COMPLETED'">
      <div class="job-header">
        <span class="job-status-badge" [attr.data-status]="j.status">{{ j.status }}</span>
        @if (polling()) {
          <span class="job-polling">Refreshing…</span>
        }
      </div>

      <div class="progress-group">
        <div class="progress-label">{{ j.percent }}% processed</div>
        <div class="progress-bar-track">
          <div class="progress-bar-fill" [class.green]="j.status === 'COMPLETED'" [style.width.%]="j.percent"></div>
        </div>
      </div>

      <div class="job-counts">
        <span class="count inserted">{{ j.insertedCount }} inserted</span>
        <span class="count skipped">{{ j.skippedCount }} skipped</span>
        <span class="count errors" [class.has-errors]="j.errorCount > 0">{{ j.errorCount }} errors</span>
      </div>

      @if (j.status === 'FAILED') {
        <button type="button" class="primary-btn retry-btn" (click)="retry()">Retry</button>
      }

      @if (j.status === 'COMPLETED' || j.status === 'FAILED') {
        <button type="button" class="ghost-btn new-btn" (click)="goBack()">← Back to Admin</button>
      }
    </div>

    <!-- Errors table -->
    @if (errorsPage(); as ep) {
      <app-vocab-import-errors-table
        [errorsPage]="ep"
        (pageChange)="loadErrors($event)"
      />
    }
  }
</section>

