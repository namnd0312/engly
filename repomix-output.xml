<file path="engly-be/src/test/java/com/engly/identity/application/AuthTokenServiceTest.java">
package com.engly.identity.application;

import com.engly.identity.config.AuthProperties;
import com.engly.identity.config.JwtKeyConfig;
import com.engly.identity.domain.InvalidLoginException;
import com.engly.identity.domain.RefreshToken;
import com.engly.identity.domain.UserAccount;
import com.engly.identity.infrastructure.RefreshTokenRepository;
import com.engly.identity.infrastructure.UserAccountRepository;
import jakarta.servlet.http.Cookie;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.ArgumentCaptor;
import org.springframework.mock.web.MockHttpServletRequest;
import org.springframework.mock.web.MockHttpServletResponse;
import org.springframework.security.oauth2.jwt.Jwt;
import org.springframework.security.oauth2.jwt.JwtDecoder;

import java.time.Duration;
import java.time.Instant;
import java.util.List;
import java.util.Optional;
import java.util.UUID;

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;

/**
 * Unit tests for {@link AuthTokenService}: access-JWT minting, refresh-token rotation, and cookie
 * issuing/clearing. Uses a real HS256 encoder/decoder (ephemeral key from {@link JwtKeyConfig}) and
 * mocked repositories.
 */
class AuthTokenServiceTest {

    private RefreshTokenRepository refreshTokens;
    private UserAccountRepository users;
    private AuthTokenService service;
    private JwtDecoder decoder;

    private final AuthProperties props = new AuthProperties(
            "engly", Duration.ofMinutes(15), Duration.ofDays(30), null, null);

    @BeforeEach
    void setUp() {
        JwtKeyConfig keyConfig = new JwtKeyConfig(props);
        decoder = keyConfig.jwtDecoder();
        refreshTokens = mock(RefreshTokenRepository.class);
        users = mock(UserAccountRepository.class);
        when(refreshTokens.save(any(RefreshToken.class))).thenAnswer(inv -> inv.getArgument(0));
        service = new AuthTokenService(keyConfig.jwtEncoder(), refreshTokens, users, props);
    }

    private UserAccount sampleUser() {
        return UserAccount.localUser("local-7", "u@example.com", "irrelevant-hash", "Sample User");
    }

    @Test
    void issueSession_writesBothCookies_andAccessTokenCarriesClaims() {
        MockHttpServletResponse response = new MockHttpServletResponse();

        service.issueSession(sampleUser(), response);

        Cookie access = response.getCookie("ACCESS_TOKEN");
        Cookie refresh = response.getCookie("REFRESH_TOKEN");
        assertThat(access).isNotNull();
        assertThat(access.isHttpOnly()).isTrue();
        assertThat(access.getPath()).isEqualTo("/");
        assertThat(refresh).isNotNull();
        assertThat(refresh.isHttpOnly()).isTrue();
        assertThat(refresh.getPath()).isEqualTo("/api/auth");

        Jwt decoded = decoder.decode(access.getValue());
        assertThat(decoded.getSubject()).isEqualTo("local-7");
        assertThat(decoded.getClaimAsString("email")).isEqualTo("u@example.com");
        assertThat(decoded.getClaimAsStringList("roles")).containsExactly("ROLE_USER");

        verify(refreshTokens).save(any(RefreshToken.class));
    }

    @Test
    void rotate_validRefreshCookie_revokesOldAndIssuesNew() {
        UserAccount user = sampleUser();

        // First issue a session to capture a real refresh cookie + the persisted token.
        MockHttpServletResponse first = new MockHttpServletResponse();
        service.issueSession(user, first);
        String rawRefresh = first.getCookie("REFRESH_TOKEN").getValue();

        ArgumentCaptor<RefreshToken> saved = ArgumentCaptor.forClass(RefreshToken.class);
        verify(refreshTokens).save(saved.capture());
        RefreshToken stored = saved.getValue();

        when(refreshTokens.findByTokenHash(stored.getTokenHash())).thenReturn(Optional.of(stored));
        // user.getId() is null without JPA → match any lookup (incl. null) via any().
        when(users.findById(any())).thenReturn(Optional.of(user));

        MockHttpServletRequest request = new MockHttpServletRequest();
        request.setCookies(new Cookie("REFRESH_TOKEN", rawRefresh));
        MockHttpServletResponse second = new MockHttpServletResponse();

        service.rotate(request, second);

        assertThat(stored.isRevoked()).isTrue();
        assertThat(second.getCookie("ACCESS_TOKEN")).isNotNull();
        assertThat(second.getCookie("REFRESH_TOKEN")).isNotNull();
        // A second refresh row was persisted (rotation).
        verify(refreshTokens, org.mockito.Mockito.times(2)).save(any(RefreshToken.class));
    }

    @Test
    void rotate_missingCookie_throws401() {
        MockHttpServletRequest request = new MockHttpServletRequest();
        assertThatThrownBy(() -> service.rotate(request, new MockHttpServletResponse()))
                .isInstanceOf(InvalidLoginException.class);
    }

    @Test
    void rotate_unknownToken_throws401() {
        when(refreshTokens.findByTokenHash(any())).thenReturn(Optional.empty());
        MockHttpServletRequest request = new MockHttpServletRequest();
        request.setCookies(new Cookie("REFRESH_TOKEN", "some-unknown-token"));

        assertThatThrownBy(() -> service.rotate(request, new MockHttpServletResponse()))
                .isInstanceOf(InvalidLoginException.class);
    }

    @Test
    void rotate_expiredToken_throws401() {
        RefreshToken expired = new RefreshToken(UUID.randomUUID(), "hash", Instant.now().minusSeconds(60));
        when(refreshTokens.findByTokenHash("hash")).thenReturn(Optional.of(expired));
        MockHttpServletRequest request = new MockHttpServletRequest();
        // Token value irrelevant — service hashes it; stub matches the resulting lookup via any() below.
        request.setCookies(new Cookie("REFRESH_TOKEN", "raw"));
        when(refreshTokens.findByTokenHash(any())).thenReturn(Optional.of(expired));

        assertThatThrownBy(() -> service.rotate(request, new MockHttpServletResponse()))
                .isInstanceOf(InvalidLoginException.class);
    }

    @Test
    void clearSession_revokesPresentedTokenAndExpiresCookies() {
        RefreshToken active = new RefreshToken(UUID.randomUUID(), "hash", Instant.now().plusSeconds(3600));
        when(refreshTokens.findByTokenHash(any())).thenReturn(Optional.of(active));

        MockHttpServletRequest request = new MockHttpServletRequest();
        request.setCookies(new Cookie("REFRESH_TOKEN", "raw"));
        MockHttpServletResponse response = new MockHttpServletResponse();

        service.clearSession(request, response);

        assertThat(active.isRevoked()).isTrue();
        assertThat(response.getCookie("ACCESS_TOKEN").getMaxAge()).isZero();
        assertThat(response.getCookie("REFRESH_TOKEN").getMaxAge()).isZero();
    }

    @Test
    void accessCookieName_returnsConfiguredName() {
        assertThat(service.accessCookieName()).isEqualTo("ACCESS_TOKEN");
    }
}
</file>

<file path="engly-be/src/test/java/com/engly/identity/application/SocialLoginServiceTest.java">
package com.engly.identity.application;

import com.engly.identity.domain.UserAccount;
import com.engly.identity.infrastructure.UserAccountRepository;
import com.engly.identity.infrastructure.UserIdentityRepository;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.security.core.authority.SimpleGrantedAuthority;
import org.springframework.security.oauth2.core.user.DefaultOAuth2User;
import org.springframework.security.oauth2.core.user.OAuth2User;
import org.springframework.test.context.DynamicPropertyRegistry;
import org.springframework.test.context.DynamicPropertySource;
import org.testcontainers.containers.PostgreSQLContainer;
import org.testcontainers.junit.jupiter.Container;
import org.testcontainers.junit.jupiter.Testcontainers;

import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.UUID;
import java.util.concurrent.CompletableFuture;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;

import static org.assertj.core.api.Assertions.assertThat;

/**
 * Resolve-or-link behavior against a real Postgres (Flyway incl. V10). Exercises the verified-both-sides
 * linking policy and the concurrent-create isolation — both need real transactions/constraints, so this
 * is an integration test rather than a mocked unit slice.
 */
@SpringBootTest
@Testcontainers
@Tag("integration")
class SocialLoginServiceTest {

    @Container
    static PostgreSQLContainer<?> postgres = new PostgreSQLContainer<>("postgres:16-alpine");

    @DynamicPropertySource
    static void datasourceProps(DynamicPropertyRegistry registry) {
        registry.add("spring.datasource.url", postgres::getJdbcUrl);
        registry.add("spring.datasource.username", postgres::getUsername);
        registry.add("spring.datasource.password", postgres::getPassword);
    }

    @Autowired private SocialLoginService service;
    @Autowired private UserAccountRepository users;
    @Autowired private UserIdentityRepository identities;
    @Autowired private EmailVerificationService emailVerificationService;

    private static OAuth2User google(String sub, String email, boolean emailVerified, String name) {
        Map<String, Object> attrs = new HashMap<>();
        attrs.put("sub", sub);
        if (email != null) attrs.put("email", email);
        attrs.put("email_verified", emailVerified);
        attrs.put("name", name);
        return new DefaultOAuth2User(List.of(new SimpleGrantedAuthority("ROLE_USER")), attrs, "sub");
    }

    private static OAuth2User facebook(String id, String email, String name) {
        Map<String, Object> attrs = new HashMap<>();
        attrs.put("id", id);
        if (email != null) attrs.put("email", email);
        attrs.put("name", name);
        return new DefaultOAuth2User(List.of(new SimpleGrantedAuthority("ROLE_USER")), attrs, "id");
    }

    /** Seed a local account directly (bypasses the SSO flow) to set up link/no-merge preconditions. */
    private UserAccount seed(String email, boolean verified, String passwordHash) {
        UserAccount user = passwordHash != null
                ? UserAccount.localUser("local-" + UUID.randomUUID(), email, passwordHash, "Seeded")
                : UserAccount.ssoUser("sso-" + UUID.randomUUID(), email, "Seeded", verified);
        return users.save(user);
    }

    @Test
    void returningLogin_resolvesToSameAccount_noDuplicateIdentity() {
        String sub = "g-return-" + UUID.randomUUID();
        UserAccount first = service.resolveOrLink("google", google(sub, "return@example.com", true, "R"));
        UserAccount again = service.resolveOrLink("google", google(sub, "return@example.com", true, "R"));

        assertThat(again.getId()).isEqualTo(first.getId());
        assertThat(identities.findByProviderAndProviderUserId("google", sub)).isPresent();
    }

    @Test
    void googleVerified_linksIntoExistingVerifiedAccount() {
        UserAccount existing = seed("verified-link@example.com", true, null);
        String sub = "g-link-" + UUID.randomUUID();

        UserAccount result = service.resolveOrLink("google", google(sub, "verified-link@example.com", true, "V"));

        assertThat(result.getId()).isEqualTo(existing.getId());          // linked, not duplicated
        assertThat(identities.findByProviderAndProviderUserId("google", sub)).isPresent();
    }

    @Test
    void googleVerified_doesNotMergeIntoUnverifiedPasswordAccount() {
        UserAccount password = seed("squatted@example.com", false, "$2a$10$hash");
        String sub = "g-nomerge-" + UUID.randomUUID();

        UserAccount result = service.resolveOrLink("google", google(sub, "squatted@example.com", true, "V"));

        assertThat(result.getId()).isNotEqualTo(password.getId());       // separate account, no takeover
        assertThat(result.hasPassword()).isFalse();
    }

    @Test
    void googleVerified_linksIntoActivatedPasswordAccount() {
        // Email activation on registration: once a password account clicks its activation link
        // (email_verified flips false→true), it becomes a valid SSO link target — the intended
        // "verified-both-sides" merge (see plan.md "SSO linking interaction"), unlike the
        // still-unverified case above which stays separate.
        UserAccount password = seed("activated@example.com", false, "$2a$10$hash");
        emailVerificationService.markVerifiedImmediately(password);
        String sub = "g-activated-" + UUID.randomUUID();

        UserAccount result = service.resolveOrLink("google", google(sub, "activated@example.com", true, "V"));

        assertThat(result.getId()).isEqualTo(password.getId());          // linked into the SAME account
        assertThat(identities.findByProviderAndProviderUserId("google", sub)).isPresent();
    }

    @Test
    void googleVerified_noMatch_createsVerifiedAccount() {
        String sub = "g-new-" + UUID.randomUUID();
        UserAccount result = service.resolveOrLink("google", google(sub, "brandnew@example.com", true, "N"));

        assertThat(result.isEmailVerified()).isTrue();
        assertThat(result.getEmail()).isEqualTo("brandnew@example.com");
    }

    @Test
    void facebook_neverLinksByEmail_evenWhenEmailMatchesVerifiedAccount() {
        UserAccount existing = seed("fbmatch@example.com", true, null);
        String id = "fb-nolink-" + UUID.randomUUID();

        UserAccount result = service.resolveOrLink("facebook", facebook(id, "fbmatch@example.com", "F"));

        assertThat(result.getId()).isNotEqualTo(existing.getId());       // Facebook email not trusted
        assertThat(result.isEmailVerified()).isFalse();
    }

    @Test
    void facebook_withoutEmail_createsEmaillessAccount() {
        String id = "fb-noemail-" + UUID.randomUUID();
        UserAccount result = service.resolveOrLink("facebook", facebook(id, null, "F"));

        assertThat(result.getEmail()).isNull();
        assertThat(identities.findByProviderAndProviderUserId("facebook", id)).isPresent();
    }

    @Test
    void googleVerified_mixedCaseEmail_normalizesAndLinks() {
        UserAccount existing = seed("mixed@example.com", true, null);   // stored lowercase
        String sub = "g-mixed-" + UUID.randomUUID();

        UserAccount result = service.resolveOrLink("google", google(sub, "Mixed@Example.COM", true, "M"));

        assertThat(result.getId()).isEqualTo(existing.getId());          // matched despite casing
    }

    @Test
    void concurrentFirstLogin_sameIdentity_yieldsSingleAccount() throws Exception {
        String sub = "g-race-" + UUID.randomUUID();
        OAuth2User principal = google(sub, "race@example.com", true, "Race");
        ExecutorService pool = Executors.newFixedThreadPool(2);
        try {
            CompletableFuture<UUID> a = CompletableFuture.supplyAsync(
                    () -> service.resolveOrLink("google", principal).getId(), pool);
            CompletableFuture<UUID> b = CompletableFuture.supplyAsync(
                    () -> service.resolveOrLink("google", principal).getId(), pool);

            assertThat(a.get()).isEqualTo(b.get());                      // both resolve to one account
            assertThat(users.findByEmail("race@example.com")).isPresent();
        } finally {
            pool.shutdownNow();
        }
    }
}
