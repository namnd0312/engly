<file path="k8s/30-engly-fe-frontend.yaml">
# Engly frontend (nginx + Angular SPA). NodePort type so it is reachable on the
# node IP at a fixed port (works on local clusters like OrbStack where LoadBalancer
# external IPs stay <pending>). Access at http://<node-ip>:30090.
# nginx reverse-proxies /api → engly-be Service, so the browser sees a single origin.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: engly-fe
  namespace: engly
  labels:
    app: engly-fe
spec:
  replicas: 1
  selector:
    matchLabels:
      app: engly-fe
  template:
    metadata:
      labels:
        app: engly-fe
    spec:
      containers:
        - name: engly-fe
          image: engly-fe:local
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 80
          readinessProbe:
            httpGet:
              path: /
              port: 80
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: 80
            initialDelaySeconds: 15
            periodSeconds: 15
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              memory: 128Mi
---
apiVersion: v1
kind: Service
metadata:
  name: engly-fe
  namespace: engly
spec:
  type: NodePort
  selector:
    app: engly-fe
  ports:
    - port: 80
      targetPort: 80
      nodePort: 30090
</file>

<file path="docker-compose.yml">
services:
  postgres:
    image: postgres:16-alpine
    container_name: engly-postgres
    ports:
      - "5433:5432"
    environment:
      POSTGRES_DB: engly
      POSTGRES_USER: engly
      POSTGRES_PASSWORD: engly
    volumes:
      - engly-pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U engly -d engly"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Local AWS emulator (S3 + Lambda) for the avatar feature. Lambda functions run in
  # real Docker containers, hence the docker.sock mount. Credentials are the emulator
  # defaults test/test; browser reaches it at localhost:4566, k8s pods via host.orb.internal:4566.
  # One-time resource setup: ./infra/floci/setup-floci.sh
  #
  # Opt-in profile: a standalone Floci often already runs on this machine (port 4566).
  # Start this one only when none is running:  docker compose --profile floci up -d
  floci:
    profiles: ["floci"]
    image: floci/floci:latest
    container_name: engly-floci
    ports:
      - "4566:4566"
    environment:
      FLOCI_STORAGE_MODE: hybrid
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - engly-floci-data:/app/data

volumes:
  engly-pgdata:
  engly-floci-data:
</file>

<file path="README.md">
# Engly — Irregular Verbs Learning Platform

Monorepo: `engly-be/` (Spring Boot 3.4.5, **Maven**) · `engly-fe/` (Angular 19) · `k8s/` (OrbStack manifests).

## Prerequisites

| Tool | Version |
|------|---------|
| Java | 21 |
| Maven | 3.9+ (or use `engly-be/mvnw`) |
| Node | 20+ |
| Docker | 24+ |
| kubectl + OrbStack k8s | for the k8s deploy |

## Local Run (dev)

```bash
# 1. Start Postgres
docker compose up -d

# 2. Start backend (port 8081)
cd engly-be && ./mvnw spring-boot:run

# 3. Start frontend (port 4200, dev proxy /api -> 8081)
cd engly-fe && npm start
```

Registration sends an activation email — without a local SMTP server the send just fails silently
(logged at WARN) and the activation link is logged at INFO instead. To view real emails, run
Mailpit: `docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit`, then check http://localhost:8025.

## Kubernetes Deploy (OrbStack)

OrbStack's Docker engine shares its image store with its k8s cluster, so locally
built images need no registry push.

```bash
sh k8s/deploy-to-orbstack.sh      # builds engly-be:local + engly-fe:local, applies k8s/
```

App is then served by the `engly-fe` LoadBalancer at **http://localhost:31485**
(nginx serves the SPA and reverse-proxies `/api` → the `engly-be` Service).
Confirm the NodePort with `kubectl -n engly get svc engly-fe`.

```bash
kubectl -n engly get pods,svc        # status
kubectl delete namespace engly       # tear down
```

## Port Table

| Service | Port |
|---------|------|
| IdP (OPEN-GATE, planned) | 9000 |
| Backend (Spring Boot) | 8081 |
| Frontend (Angular dev) | 4200 |
| Frontend (k8s LoadBalancer NodePort) | 31485 |
| Postgres (docker-compose dev) | 5433 |
| Postgres (in-cluster Service) | 5432 |

## Stop (local dev)

```bash
docker compose down        # stop (keep volume)
docker compose down -v     # stop + delete data
```

## Tests

```bash
cd engly-be && ./mvnw test                                  # backend: 24 tests (Testcontainers needs Docker)
cd engly-fe && npx ng test --watch=false --browsers=ChromeHeadless   # frontend: 13 specs
```
</file>

<file path="engly-be/src/test/java/com/engly/identity/api/AuthControllerTest.java">
package com.engly.identity.api;

import com.engly.common.GlobalExceptionHandler;
import com.engly.common.SecurityConfig;
import com.engly.identity.application.AuthTokenService;
import com.engly.identity.application.EmailVerificationService;
import com.engly.identity.application.UserAccountService;
import com.engly.identity.domain.EmailAlreadyExistsException;
import com.engly.identity.domain.InvalidLoginException;
import com.engly.identity.domain.UserAccount;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.servlet.WebMvcTest;
import org.springframework.context.annotation.Import;
import org.springframework.http.MediaType;
import org.springframework.security.oauth2.jwt.JwtDecoder;
import org.springframework.test.context.bean.override.mockito.MockitoBean;
import org.springframework.test.web.servlet.MockMvc;

import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.doThrow;
import static org.mockito.Mockito.never;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;
import static org.springframework.security.test.web.servlet.request.SecurityMockMvcRequestPostProcessors.csrf;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

/**
 * Slice tests for {@link AuthController}: register/login/refresh/logout status codes, response
 * projection, and error mapping. Service + token layers are mocked; CSRF is disabled for
 * login/register/refresh (see SecurityConfig) but required for logout.
 */
@WebMvcTest(AuthController.class)
@Import({SecurityConfig.class, GlobalExceptionHandler.class})
class AuthControllerTest {

    @Autowired
    private MockMvc mockMvc;

    @MockitoBean private UserAccountService accountService;
    @MockitoBean private AuthTokenService tokenService;
    @MockitoBean private EmailVerificationService emailVerificationService;

    // SecurityConfig chain deps.
    @MockitoBean private JwtDecoder jwtDecoder;

    private static UserAccount sampleUser() {
        return UserAccount.localUser("local-x", "alice@example.com", "hash", "Alice");
    }

    @Test
    void register_valid_withEmailVerificationEnabled_returns202WithEmail() throws Exception {
        when(accountService.register(any(), any(), any())).thenReturn(sampleUser());
        when(emailVerificationService.isEnabled()).thenReturn(true);

        mockMvc.perform(post("/api/auth/register")
                        .contentType(MediaType.APPLICATION_JSON)
                        .content("{\"email\":\"alice@example.com\",\"password\":\"supersecret\",\"displayName\":\"Alice\"}"))
                .andExpect(status().isAccepted())
                .andExpect(jsonPath("$.email").value("alice@example.com"))
                .andExpect(jsonPath("$.sub").doesNotExist());

        verify(emailVerificationService).startVerification(any());
        verify(tokenService, never()).issueSession(any(), any());
    }

    @Test
    void register_valid_withEmailVerificationDisabled_returns200WithIdentity() throws Exception {
        when(accountService.register(any(), any(), any())).thenReturn(sampleUser());
        when(emailVerificationService.isEnabled()).thenReturn(false);

        mockMvc.perform(post("/api/auth/register")
                        .contentType(MediaType.APPLICATION_JSON)
                        .content("{\"email\":\"alice@example.com\",\"password\":\"supersecret\",\"displayName\":\"Alice\"}"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.sub").doesNotExist())
                .andExpect(jsonPath("$.email").value("alice@example.com"))
                .andExpect(jsonPath("$.isAdmin").value(false));

        verify(emailVerificationService).markVerifiedImmediately(any());
        verify(tokenService).issueSession(any(), any());
    }

    @Test
    void register_duplicateEmail_returns409() throws Exception {
        when(accountService.register(any(), any(), any()))
                .thenThrow(new EmailAlreadyExistsException("alice@example.com"));

        mockMvc.perform(post("/api/auth/register")
                        .contentType(MediaType.APPLICATION_JSON)
                        .content("{\"email\":\"alice@example.com\",\"password\":\"supersecret\",\"displayName\":\"Alice\"}"))
                .andExpect(status().isConflict());
    }

    @Test
    void register_invalidPayload_returns400() throws Exception {
        // Blank email + too-short password → bean validation fails before the service is touched.
        mockMvc.perform(post("/api/auth/register")
                        .contentType(MediaType.APPLICATION_JSON)
                        .content("{\"email\":\"\",\"password\":\"short\",\"displayName\":\"Alice\"}"))
                .andExpect(status().isBadRequest());
    }

    @Test
    void login_valid_returns200() throws Exception {
        when(accountService.login(any(), any())).thenReturn(sampleUser());

        mockMvc.perform(post("/api/auth/login")
                        .contentType(MediaType.APPLICATION_JSON)
                        .content("{\"email\":\"alice@example.com\",\"password\":\"supersecret\"}"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.email").value("alice@example.com"))
                .andExpect(jsonPath("$.sub").doesNotExist());

        verify(tokenService).issueSession(any(), any());
    }

    @Test
    void login_badCredentials_returns401() throws Exception {
        when(accountService.login(any(), any()))
                .thenThrow(new InvalidLoginException("Invalid email or password"));

        mockMvc.perform(post("/api/auth/login")
                        .contentType(MediaType.APPLICATION_JSON)
                        .content("{\"email\":\"alice@example.com\",\"password\":\"wrong\"}"))
                .andExpect(status().isUnauthorized());
    }

    @Test
    void refresh_valid_returns200() throws Exception {
        mockMvc.perform(post("/api/auth/refresh"))
                .andExpect(status().isOk());

        verify(tokenService).rotate(any(), any());
    }

    @Test
    void refresh_invalid_returns401() throws Exception {
        doThrow(new InvalidLoginException("Invalid refresh token"))
                .when(tokenService).rotate(any(), any());

        mockMvc.perform(post("/api/auth/refresh"))
                .andExpect(status().isUnauthorized());
    }

    @Test
    void logout_withCsrf_returns200() throws Exception {
        mockMvc.perform(post("/api/auth/logout").with(csrf()))
                .andExpect(status().isOk());

        verify(tokenService).clearSession(any(), any());
    }
}
