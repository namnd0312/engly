              <td class="ipa">{{ verb.ipaPast ?? '—' }}</td>
              <td class="ipa">{{ verb.ipaPp ?? '—' }}</td>
              <td class="meaning">{{ verb.meaningVi ?? '—' }}</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</section>

